---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import Analytics from '../components/Analytics.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'AutoRepair',
  name: site.legalName,
  url: site.url,
  telephone: site.phones[0].number,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '2-й Короткий пер., 23',
    addressLocality: 'Минск',
    addressCountry: 'BY',
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  openingHours: site.hoursSchema,
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: site.rating.value,
    reviewCount: site.rating.reviewsCount,
  },
};
---

<Base title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <div class="min-h-dvh bg-slate-50 font-[Inter] text-slate-800 antialiased dark:bg-slate-950 dark:text-slate-200">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <StickyCta />
    <Analytics />
  </div>

  <script>
    // Яндекс.Карта: тёмная/светлая тема виджета синхронно с темой сайта
    function syncMaps() {
      const dark = document.documentElement.classList.contains('dark');
      document.querySelectorAll('.yandex-map').forEach((f) => {
        const src = dark ? f.dataset.dark : f.dataset.light;
        if (f.src !== src) f.src = src;
      });
    }
    syncMaps();
    new MutationObserver(syncMaps).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  </script>
</Base>
