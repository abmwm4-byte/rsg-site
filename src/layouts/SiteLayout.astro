---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import Analytics from '../components/Analytics.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'AutoRepair',
  name: site.legalName,
  url: site.url,
  telephone: site.phones[0].number,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '2-й Короткий пер., 23',
    addressLocality: 'Минск',
    addressCountry: 'BY',
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  openingHours: site.hoursSchema,
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: site.rating.value,
    reviewCount: site.rating.reviewsCount,
  },
};
---

<Base title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <div class="min-h-screen bg-slate-50 font-[Inter] text-slate-800 antialiased dark:bg-slate-950 dark:text-slate-200">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <StickyCta />
    <Analytics />
  </div>

  <script>
    // Кнопки «Маршрут» (.route-btn): мгновенное открытие Яндекс Навигатора на мобильных
    document.querySelectorAll('.route-btn:not([data-route-bound])').forEach((btn) => {
      btn.setAttribute('data-route-bound', '1');
      btn.addEventListener('click', (e) => {
        const ua = navigator.userAgent;
        const isAndroid = /Android/i.test(ua);
        const isIOS = /iPhone|iPad/i.test(ua);
        if (!isAndroid && !isIOS) return; // десктоп — веб-карты по href

        e.preventDefault();
        if (isAndroid) {
          // intent:// открывает Навигатор с маршрутом; без приложения — веб-фолбэк
          window.location.href = btn.getAttribute('data-intent');
          return;
        }
        // iOS: схема приложения + таймер-фолбэк на веб
        let opened = false;
        document.addEventListener('visibilitychange', () => { opened = true; }, { once: true });
        window.location.href = btn.getAttribute('data-scheme');
        setTimeout(() => { if (!opened) window.location.href = btn.getAttribute('href'); }, 1500);
      });
    });
  </script>
</Base>
