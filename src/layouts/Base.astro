---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://remontstarterov.by');
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <style>
      /* Фон до загрузки основного CSS — убирает чёрную/белую вспышку */
      html { background-color: #f8fafc; }
      html.dark { background-color: #020617; }
    </style>
    <script is:inline>
      // Тема: light | auto | dark (localStorage rsg-theme). Auto — по восходу/закату в Минске.
      (function () {
        var LAT = 53.8918, LNG = 27.479, TZ = 3;
        function sunHours(date) {
          var start = new Date(date.getFullYear(), 0, 0);
          var n = Math.floor((date - start) / 864e5);
          var rad = Math.PI / 180;
          var decl = 23.44 * rad * Math.sin(rad * (360 / 365) * (n - 81));
          var latR = LAT * rad;
          var cosH = (Math.cos(90.833 * rad) - Math.sin(latR) * Math.sin(decl)) / (Math.cos(latR) * Math.cos(decl));
          cosH = Math.max(-1, Math.min(1, cosH));
          var dayLen = (2 * Math.acos(cosH) / rad) / 15;
          var noon = 12 + TZ - LNG / 15; // локальный солнечный полдень ~13:10
          return [noon - dayLen / 2, noon + dayLen / 2];
        }
        function autoDark() {
          var now = new Date();
          var t = sunHours(now);
          var h = now.getHours() + now.getMinutes() / 60;
          return h < t[0] || h >= t[1];
        }
        function apply(mode) {
          var dark = mode === 'dark' || (mode !== 'light' && autoDark());
          document.documentElement.classList.toggle('dark', dark);
          document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
        }
        function getMode() {
          try { return localStorage.getItem('rsg-theme') || 'auto'; } catch (e) { return 'auto'; }
        }
        apply(getMode());
        window.__rsgTheme = { apply: apply };
        setInterval(function () { if (getMode() === 'auto') apply('auto'); }, 10 * 60 * 1000);
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <script type="speculationrules">
      {"prerender": [{"where": {"href_matches": "/*"}, "eagerness": "moderate"}]}
    </script>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ru_BY" />
    <meta property="og:image" content="https://remontstarterov.by/images/workshop-engine.jpg" />
    <meta name="theme-color" content="#2563eb" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://mc.yandex.ru" crossorigin />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/inter-cyrillic.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/inter-latin.woff2" />
  </head>
  <body>
    <slot />
  </body>
</html>
