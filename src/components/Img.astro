---
// Картинка с AVIF + WebP fallback. AVIF-файл обязан существовать (генерирует scripts/make-thumbs.mjs).
interface Props {
  src: string;
  alt: string;
  class?: string;
  width?: number;
  height?: number;
  eager?: boolean;
}
const { src, alt, class: cls, width, height, eager = false } = Astro.props;
const avif = /\.webp$/i.test(src) ? src.replace(/\.webp$/i, '.avif') : null;
---

{avif ? (
  <picture>
    <source srcset={avif} type="image/avif" />
    <img src={src} alt={alt} width={width} height={height} loading={eager ? 'eager' : 'lazy'} decoding="async" class={cls} />
  </picture>
) : (
  <img src={src} alt={alt} width={width} height={height} loading={eager ? 'eager' : 'lazy'} decoding="async" class={cls} />
)}
