---
interface Props {
  active: 'all' | 'startery' | 'generatory';
  counts: { all: number; startery: number; generatory: number };
}
const { active, counts } = Astro.props;

const tabs = [
  { id: 'all', label: 'Все кейсы', href: '/keisy/', count: counts.all },
  { id: 'startery', label: 'Стартеры', href: '/keisy/startery/', count: counts.startery },
  { id: 'generatory', label: 'Генераторы', href: '/keisy/generatory/', count: counts.generatory },
] as const;

const base = 'whitespace-nowrap rounded-xl px-3 py-1.5 text-[13px] font-semibold transition sm:px-4 sm:py-2 sm:text-sm';
const on = 'bg-white text-slate-900 shadow-sm dark:bg-slate-900 dark:text-white';
const off = 'text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200';
---

<div class="flex justify-center sm:justify-start">
<div id="unit-tabs" class="inline-flex max-w-full gap-1 overflow-x-auto rounded-2xl border border-slate-200 bg-slate-100 p-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden dark:border-slate-700 dark:bg-slate-800">
  {tabs.map((t) => (
    <a href={t.href} data-active={active === t.id ? '1' : undefined} class={`${base} ${active === t.id ? on : off}`}>
      {t.label} <span class={active === t.id ? 'text-slate-400' : 'text-slate-400/80'}>{t.count}</span>
    </a>
  ))}
</div>
</div>

<script is:inline>
  // Мобильные: докрутить табы, чтобы активная вкладка была видна целиком
  (() => {
    const box = document.getElementById('unit-tabs');
    const cur = box?.querySelector('[data-active]');
    if (box && cur) box.scrollLeft = cur.offsetLeft - box.offsetLeft - 8;
  })();
</script>
