---
import { calculator, site } from '../data/site';
---

<section id="calculator" class="mx-auto max-w-6xl px-4 py-16">
  <div class="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm md:p-12">
    <h2 class="text-3xl font-extrabold tracking-tight text-slate-900">Примерная стоимость ремонта</h2>
    <p class="mt-2 text-slate-500">Выберите узел и работу — покажем ориентировочную вилку</p>

    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <div>
        <label for="calc-unit" class="mb-2 block text-sm font-semibold text-slate-700">Что ремонтируем?</label>
        <select id="calc-unit" class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-800 focus:border-blue-500 focus:outline-none">
          {calculator.units.map((u) => <option value={u.id}>{u.label}</option>)}
        </select>
      </div>
      <div>
        <label for="calc-job" class="mb-2 block text-sm font-semibold text-slate-700">Какая работа нужна?</label>
        <select id="calc-job" class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-800 focus:border-blue-500 focus:outline-none"></select>
      </div>
    </div>

    <div class="mt-8 rounded-2xl bg-blue-50 p-6 text-center">
      <div class="text-sm font-semibold uppercase tracking-wide text-blue-700">Ориентировочная стоимость</div>
      <div id="calc-result" class="mt-2 text-4xl font-extrabold text-blue-700">—</div>
      <p class="mt-3 text-sm text-slate-500">{calculator.disclaimer}</p>
      <div class="mt-5 flex flex-wrap justify-center gap-3">
        <a href={site.phones[0].href} data-goal="call" class="rounded-xl bg-blue-600 px-6 py-3 font-bold text-white transition hover:bg-blue-700">Уточнить по телефону</a>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ units: calculator.units }}>
  const unitSelect = document.getElementById('calc-unit');
  const jobSelect = document.getElementById('calc-job');
  const result = document.getElementById('calc-result');

  function fillJobs() {
    const unit = units.find((u) => u.id === unitSelect.value);
    jobSelect.innerHTML = '';
    unit.jobs.forEach((j) => {
      const opt = document.createElement('option');
      opt.value = j.id;
      opt.textContent = j.label;
      jobSelect.appendChild(opt);
    });
    showPrice();
  }

  function showPrice() {
    const unit = units.find((u) => u.id === unitSelect.value);
    const job = unit.jobs.find((j) => j.id === jobSelect.value);
    result.textContent = job ? `${job.min}–${job.max} BYN` : '—';
  }

  unitSelect.addEventListener('change', fillJobs);
  jobSelect.addEventListener('change', showPrice);
  fillJobs();
</script>
