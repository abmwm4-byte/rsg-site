---
// Переключатель темы: Светлая / Авто (восход-закат Минск) / Тёмная.
// Логика применения — в Base.astro (window.__rsgTheme), здесь только UI и сохранение выбора.
---

<div class="theme-toggle flex shrink-0 items-center rounded-full border border-slate-200 bg-slate-100 p-0.5 dark:border-slate-700 dark:bg-slate-800" role="group" aria-label="Тема оформления">
  <button type="button" data-theme-btn="light" aria-label="Светлая тема" title="Светлая" class="rounded-full p-1.5 transition">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  </button>
  <button type="button" data-theme-btn="auto" aria-label="Авто: по восходу и закату" title="Авто: восход/закат" class="rounded-full p-1.5 transition">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 1 0 18V3Z" fill="currentColor" stroke="none"/></svg>
  </button>
  <button type="button" data-theme-btn="dark" aria-label="Тёмная тема" title="Тёмная" class="rounded-full p-1.5 transition">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
  </button>
</div>

<script>
  const toggle = document.querySelector('.theme-toggle');
  const buttons = toggle.querySelectorAll('[data-theme-btn]');
  const ACTIVE = ['bg-white', 'shadow', 'text-blue-600', 'dark:bg-slate-600', 'dark:text-blue-400'];
  const IDLE = ['text-slate-500', 'dark:text-slate-400'];

  function currentMode() {
    try { return localStorage.getItem('rsg-theme') || 'auto'; } catch (e) { return 'auto'; }
  }
  function mark() {
    const mode = currentMode();
    buttons.forEach((b) => {
      const active = b.dataset.themeBtn === mode;
      b.classList.remove(...ACTIVE, ...IDLE);
      b.classList.add(...(active ? ACTIVE : IDLE));
    });
  }
  buttons.forEach((b) => b.addEventListener('click', () => {
    const mode = b.dataset.themeBtn;
    try { localStorage.setItem('rsg-theme', mode); } catch (e) {}
    window.__rsgTheme.apply(mode);
    mark();
  }));
  mark();
</script>
