---
import { services } from '../data/site';
---

<section class="mx-auto max-w-6xl px-4 py-16" id="services">
  <div class="mb-10 text-center">
    <h2 class="text-3xl font-extrabold tracking-tight text-slate-900">Услуги и цены</h2>
    <p class="mt-2 text-slate-500">Точную стоимость называем после осмотра — до начала работ</p>
  </div>
  <div class="grid gap-5 md:grid-cols-3">
    {services.map((s) => (
      <a href={s.href} class="group rounded-3xl border border-slate-200 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-xl">
        <h3 class="text-xl font-bold text-slate-900 group-hover:text-blue-600">{s.title}</h3>
        <p class="mt-3 text-sm leading-relaxed text-slate-600">{s.description}</p>
        <div class="mt-6 flex items-center justify-between">
          <span class="text-2xl font-extrabold text-blue-600">{s.priceFrom}</span>
          <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-500">{s.time}</span>
        </div>
      </a>
    ))}
  </div>
</section>
