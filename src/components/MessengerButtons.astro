---
import { site } from '../data/site';

interface Props {
  size?: 'md' | 'lg';
}
const { size = 'md' } = Astro.props;
const padding = size === 'lg' ? 'px-5 py-4' : 'px-4 py-3';
---

<div class="flex flex-wrap gap-2">
  {site.messengers.map((m) => (
    <a
      href={m.href}
      data-goal={m.goal}
      class:list={[
        'rounded-2xl border border-slate-300 bg-white font-semibold text-slate-700 transition hover:border-blue-400 hover:text-blue-600',
        padding,
        m.name === 'Viber' && 'md:hidden', // viber:// на десктопе — мёртвый клик
      ]}
    >{m.name}</a>
  ))}
</div>
