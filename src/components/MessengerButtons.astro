---
import { site } from '../data/site';

interface Props {
  size?: 'md' | 'lg';
}
const { size = 'md' } = Astro.props;
const padding = size === 'lg' ? 'px-3 py-3 text-sm sm:px-5 sm:py-4 sm:text-base' : 'px-4 py-3';
---

<div class="flex flex-wrap gap-2">
  {site.messengers.map((m) => (
    <a
      href={m.href}
      data-goal={m.goal}
      class={`rounded-2xl border border-slate-300 bg-white font-semibold text-slate-700 transition hover:border-blue-400 hover:text-blue-600 ${padding}`}
    >{m.name}</a>
  ))}
</div>
