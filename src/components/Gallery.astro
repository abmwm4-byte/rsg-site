---
import Img from './Img.astro';

// Реальные фото сервиса. По мере новых снимков — заменять/добавлять здесь.
const photos = [
  { src: '/images/exterior.webp', alt: 'Вход в автосервис RSG Group — вывеска «Стартеры и генераторы»' },
  { src: '/images/work-welding.webp', alt: 'Мастер RSG Group за пайкой узла в маске' },
  { src: '/images/work-alternator.webp', alt: 'Ремонт генератора на верстаке в RSG Group' },
  { src: '/images/master.webp', alt: 'Мастер RSG Group за стойкой в мастерской' },
];
---

<section class="mx-auto max-w-6xl px-4 py-16">
  <div class="mb-8 grid items-end gap-6 md:grid-cols-2">
    <h2 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">Наша мастерская</h2>
    <p class="text-slate-600 dark:text-slate-400">
      «RSG Group» — узкопрофильный сервис: с 2015 года ремонтируем только стартеры и генераторы.
      Свой склад запчастей и стенд проверки под нагрузкой — большинство ремонтов отдаём в день обращения.
    </p>
  </div>
  <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
    {photos.map((p) => (
      <Img
        src={p.src}
        alt={p.alt}
        width={1200}
        height={900}
        class="aspect-[4/3] w-full rounded-2xl border border-slate-200 object-cover dark:border-slate-700"
      />
    ))}
  </div>
</section>
