---
import { site } from '../data/site';

const star = 'M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z';
const stars = Array.from({ length: 5 });
---

<section class="border-y border-amber-100 bg-gradient-to-br from-amber-50 via-white to-white">
  <div class="mx-auto max-w-6xl px-4 py-14">
    <div class="flex flex-col items-center gap-8 text-center md:flex-row md:gap-12 md:text-left">

      <!-- Штатный бейдж «Хорошее место» (SVG по официальному референсу Яндекса) -->
      <!-- TODO(бейдж): заменить на официальный PNG из кабинета Яндекс Бизнеса -->
      <div class="shrink-0">
        <svg viewBox="0 0 120 150" class="h-40 w-auto drop-shadow-lg" role="img" aria-label="Награда Яндекс Карт «Хорошее место»">
          <!-- лента -->
          <path d="M24 14 Q24 6 32 6 H88 Q96 6 96 14 V136 L60 118 L24 136 Z" fill="#fff" stroke="#e2e8f0" stroke-width="1.5" />
          <!-- пин -->
          <path d="M60 26 C49 26 40 35 40 47 C40 63 60 83 60 83 C60 83 80 63 80 47 C80 35 71 26 60 26 Z" fill="#FC3F1D" />
          <circle cx="60" cy="47" r="9" fill="#fff" />
          <!-- лавровые ветви -->
          <g fill="#FBBF24" stroke="#D97706" stroke-width="0.8">
            <ellipse rx="7" ry="3.5" transform="translate(18 112) rotate(60)" />
            <ellipse rx="7" ry="3.5" transform="translate(20 103) rotate(42)" />
            <ellipse rx="7" ry="3.5" transform="translate(24 95) rotate(25)" />
            <ellipse rx="7" ry="3.5" transform="translate(29 88) rotate(8)" />
            <ellipse rx="7" ry="3.5" transform="translate(102 112) rotate(-60)" />
            <ellipse rx="7" ry="3.5" transform="translate(100 103) rotate(-42)" />
            <ellipse rx="7" ry="3.5" transform="translate(96 95) rotate(-25)" />
            <ellipse rx="7" ry="3.5" transform="translate(91 88) rotate(-8)" />
          </g>
          <!-- подпись -->
          <text x="60" y="101" text-anchor="middle" font-family="Inter, sans-serif" font-weight="800" font-size="14" fill="#0f172a">Хорошее</text>
          <text x="60" y="115" text-anchor="middle" font-family="Inter, sans-serif" font-weight="800" font-size="14" fill="#0f172a">место</text>
        </svg>
      </div>

      <!-- Оценка и звёзды -->
      <div>
        <div class="flex items-end justify-center gap-3 md:justify-start">
          <span class="text-6xl font-extrabold leading-none text-slate-900">{site.rating.value}</span>
          <div class="relative pb-1.5">
            <div class="flex text-slate-200">
              {stars.map(() => <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d={star} /></svg>)}
            </div>
            <div class="absolute inset-0 overflow-hidden" style={`width: ${(site.rating.value / 5) * 100}%`}>
              <div class="flex text-amber-400">
                {stars.map(() => <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d={star} /></svg>)}
              </div>
            </div>
          </div>
        </div>
        <div class="mt-2 text-lg font-bold text-slate-900">
          {site.rating.reviewsCount} отзывов на {site.rating.source}
        </div>
        <p class="mt-1 max-w-md text-slate-600">
          Клиенты отмечают скорость, честные цены и гарантию на работы.
          Мы отвечаем на каждый отзыв.
        </p>
        <p class="mt-2 text-sm font-semibold text-amber-600">Награда Яндекс Карт за стабильно высокий рейтинг</p>
      </div>

      <!-- Кнопки -->
      <div class="flex flex-col gap-2 md:ml-auto">
        <a
          href={site.yandexMapsUrl}
          target="_blank" rel="noopener"
          class="rounded-2xl bg-blue-600 px-6 py-3 text-center font-bold text-white transition hover:bg-blue-700"
        >Читать отзывы</a>
        <a
          href={site.yandexMapsUrl}
          target="_blank" rel="noopener"
          class="rounded-2xl border border-slate-300 bg-white px-6 py-3 text-center font-semibold text-slate-700 transition hover:border-blue-400 hover:text-blue-600"
        >Оставить отзыв</a>
      </div>
    </div>
  </div>
</section>
