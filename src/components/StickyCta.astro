---
import { site } from '../data/site';
---

<div class="fixed bottom-0 z-50 flex w-full gap-2 border-t border-slate-200 bg-white/95 p-3 backdrop-blur md:hidden">
  <a
    href={site.phones[0].href}
    data-goal="call"
    class="flex flex-1 items-center justify-center gap-2 rounded-xl bg-blue-600 py-3 text-center font-bold text-white"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.9.5 2.8.7a2 2 0 0 1 1.7 2Z"/></svg>
    Позвонить
  </a>
  <a
    href={site.route.web}
    data-scheme={site.route.scheme}
    data-intent={site.route.intent}
    data-goal="route"
    aria-label="Маршрут в Яндекс Навигаторе"
    class="route-btn flex items-center justify-center rounded-xl border-2 border-blue-600 px-3 py-3 text-blue-700"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 11 19-9-9 19-2-8-8-2Z"/></svg>
  </a>
  {site.messengers.slice(0, 2).map((m) => (
    <a href={m.href} data-goal={m.goal} class="flex items-center rounded-xl border border-slate-300 px-3 py-3 text-sm font-semibold text-slate-700">{m.name}</a>
  ))}
</div>
