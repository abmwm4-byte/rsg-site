---
import { quiz, site } from '../data/site';
---

<section class="bg-white">
  <div class="mx-auto max-w-6xl px-4 py-16">
    <div class="mb-10 text-center">
      <h2 class="text-3xl font-extrabold tracking-tight text-slate-900">Что случилось с машиной?</h2>
      <p class="mt-2 text-slate-500">Выберите симптом — подскажем вероятную причину и примерную цену</p>
    </div>

    <div id="quiz-options" class="mx-auto grid max-w-4xl gap-3 sm:grid-cols-2">
      {quiz.map((q) => (
        <button
          type="button"
          data-quiz={q.id}
          class="quiz-option rounded-2xl border border-slate-200 bg-slate-50 px-6 py-5 text-left font-semibold text-slate-800 transition hover:border-blue-400 hover:bg-blue-50 hover:text-blue-700"
        >
          {q.symptom}
        </button>
      ))}
    </div>

    <div id="quiz-result" class="mx-auto mt-6 hidden max-w-2xl rounded-3xl border border-blue-200 bg-blue-50 p-8 text-center">
      <div class="text-sm font-semibold uppercase tracking-wide text-blue-700">Вероятная причина</div>
      <div id="quiz-cause" class="mt-2 text-xl font-bold text-slate-900"></div>
      <div class="mt-4 text-sm font-semibold uppercase tracking-wide text-blue-700">Ориентировочно</div>
      <div id="quiz-price" class="mt-1 text-4xl font-extrabold text-blue-700"></div>
      <p class="mt-3 text-sm text-slate-500">Точную причину и цену назовём после диагностики — от 20 BYN, 20–30 минут.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href={site.phones[0].href} data-goal="call" class="rounded-2xl bg-blue-600 px-6 py-3 font-bold text-white transition hover:bg-blue-700">Позвонить</a>
        <a id="quiz-wa" href="#" data-goal="whatsapp" class="rounded-2xl border border-slate-300 bg-white px-6 py-3 font-semibold text-slate-700 transition hover:border-blue-400 hover:text-blue-600">Написать в WhatsApp</a>
        <button id="quiz-reset" type="button" class="px-4 py-3 text-sm font-semibold text-slate-500 transition hover:text-slate-700">Не мой случай ↺</button>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ quizData: quiz, waNumber: site.whatsappNumber }}>
  const options = document.getElementById('quiz-options');
  const result = document.getElementById('quiz-result');
  const causeEl = document.getElementById('quiz-cause');
  const priceEl = document.getElementById('quiz-price');
  const waLink = document.getElementById('quiz-wa');
  const resetBtn = document.getElementById('quiz-reset');

  document.querySelectorAll('.quiz-option').forEach((btn) => {
    btn.addEventListener('click', () => {
      const q = quizData.find((item) => item.id === btn.dataset.quiz);
      if (!q) return;
      causeEl.textContent = `${q.unit}: ${q.cause}`;
      priceEl.textContent = `${q.priceMin}–${q.priceMax} BYN`;
      waLink.href = `https://wa.me/${waNumber}?text=` + encodeURIComponent(`Здравствуйте! Симптом: ${q.symptom}. Подскажите по ремонту.`);
      options.classList.add('hidden');
      result.classList.remove('hidden');
      result.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  });

  resetBtn.addEventListener('click', () => {
    result.classList.add('hidden');
    options.classList.remove('hidden');
  });
</script>
