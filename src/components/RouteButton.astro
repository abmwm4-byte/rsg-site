---
import { site } from '../data/site';

// Кнопка «Маршрут» — ведёт в карточку RSG Group в Яндекс.Картах (приложение или браузер)
interface Props {
  variant?: 'primary' | 'outline';
  size?: 'md' | 'lg';
}
const { variant = 'outline', size = 'md' } = Astro.props;

const sizeClasses = size === 'lg'
  ? 'px-4 py-3.5 text-sm sm:px-8 sm:py-4 sm:text-lg'
  : 'px-3 py-3 sm:px-6';
const classes = variant === 'primary'
  ? `rounded-2xl bg-blue-600 font-bold text-white transition hover:bg-blue-700 ${sizeClasses}`
  : `rounded-2xl border-2 border-blue-600 bg-white font-bold text-blue-700 transition hover:bg-blue-50 dark:border-blue-500 dark:bg-slate-800 dark:text-blue-400 dark:hover:bg-slate-700 ${sizeClasses}`;
---

<a
  href={site.route.web}
  data-goal="route"
  aria-label="Построить маршрут"
  class={`route-btn inline-flex items-center gap-2 ${classes}`}
>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon><line x1="8" y1="2" x2="8" y2="18"></line><line x1="16" y1="6" x2="16" y2="22"></line></svg>
  <span class="sm:hidden">Маршрут</span>
  <span class="hidden sm:inline">Построить маршрут</span>
</a>
