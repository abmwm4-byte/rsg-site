---
import { site } from '../data/site';

// Обработчик кликов — в SiteLayout.astro (один на страницу для всех .route-btn)
interface Props {
  variant?: 'primary' | 'outline';
  size?: 'md' | 'lg';
}
const { variant = 'outline', size = 'md' } = Astro.props;

const sizeClasses = size === 'lg' ? 'px-8 py-4 text-lg' : 'px-6 py-3';
const classes = variant === 'primary'
  ? `rounded-2xl bg-blue-600 font-bold text-white transition hover:bg-blue-700 ${sizeClasses}`
  : `rounded-2xl border-2 border-blue-600 bg-white font-bold text-blue-700 transition hover:bg-blue-50 ${sizeClasses}`;
---

<a
  href={site.route.web}
  data-scheme={site.route.scheme}
  data-intent={site.route.intent}
  data-goal="route"
  class={`route-btn inline-flex items-center gap-2 ${classes}`}
>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 11 19-9-9 19-2-8-8-2Z"/></svg>
  Маршрут
</a>
