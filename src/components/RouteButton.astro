---
import { site } from '../data/site';

interface Props {
  variant?: 'primary' | 'outline';
  size?: 'md' | 'lg';
}
const { variant = 'outline', size = 'md' } = Astro.props;

const { lat, lng } = site.geo;
// Схема приложения Яндекс Навигатора: сразу строит маршрут от геопозиции до сервиса
const naviScheme = `yandexnavi://build_route_on_map?lat_to=${lat}&lon_to=${lng}`;
// Веб-фолбэк: построение маршрута в Яндекс.Картах
const webUrl = `https://yandex.by/maps/?rtext=~${lat}%2C${lng}&rtt=auto`;
// Android intent: открывает Навигатор; если не установлен — автоматически веб-фолбэк
const intentUrl = `intent://build_route_on_map?lat_to=${lat}&lon_to=${lng}#Intent;scheme=yandexnavi;package=ru.yandex.yandexnavi;S.browser_fallback_url=${encodeURIComponent(webUrl)};end`;

const sizeClasses = size === 'lg' ? 'px-8 py-4 text-lg' : 'px-6 py-3';
const classes = variant === 'primary'
  ? `rounded-2xl bg-blue-600 font-bold text-white transition hover:bg-blue-700 ${sizeClasses}`
  : `rounded-2xl border-2 border-blue-600 bg-white font-bold text-blue-700 transition hover:bg-blue-50 ${sizeClasses}`;
---

<a
  href={webUrl}
  data-scheme={naviScheme}
  data-intent={intentUrl}
  data-goal="route"
  class={`route-btn inline-flex items-center gap-2 ${classes}`}
>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 11 19-9-9 19-2-8-8-2Z"/></svg>
  Маршрут
</a>

<script>
  document.querySelectorAll('.route-btn:not([data-route-bound])').forEach((btn) => {
    btn.setAttribute('data-route-bound', '1');
    btn.addEventListener('click', (e) => {
      const ua = navigator.userAgent;
      const isAndroid = /Android/i.test(ua);
      const isIOS = /iPhone|iPad/i.test(ua);
      // Десктоп — обычный переход в веб-карты
      if (!isAndroid && !isIOS) return;
      e.preventDefault();

      if (isAndroid) {
        // intent:// — мгновенно открывает Навигатор с маршрутом,
        // без приложения сам уходит на browser_fallback_url
        window.location.href = btn.getAttribute('data-intent');
        return;
      }

      // iOS: схема приложения + таймер-фолбэк на веб, если Навигатора нет
      let opened = false;
      document.addEventListener('visibilitychange', () => { opened = true; }, { once: true });
      window.location.href = btn.getAttribute('data-scheme');
      setTimeout(() => { if (!opened) window.location.href = btn.getAttribute('href'); }, 1500);
    });
  });
</script>
