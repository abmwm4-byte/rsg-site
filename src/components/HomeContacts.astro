---
import { site } from '../data/site';

const mapsFrame = `https://yandex.by/map-widget/v1/?display-text=${encodeURIComponent('Ремонт стартеров и генераторов')}&ll=${site.geo.lng}%2C${site.geo.lat}&mode=search&poi%5Bpoint%5D=${site.geo.lng}%2C${site.geo.lat}&poi%5Buri%5D=ymapsbm1%3A%2F%2Forg%3Foid%3D151564311231&z=16`;
---

<section class="mx-auto max-w-6xl px-4 py-16">
  <h2 class="mb-8 text-3xl font-extrabold tracking-tight text-slate-900">Как нас найти</h2>

  <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white md:grid md:grid-cols-5">
    <iframe
      src={mapsFrame}
      title="Карта: автосервис RSG Group, Минск"
      class="h-52 w-full sm:h-64 md:col-span-3 md:h-full"
      loading="lazy"
      allowfullscreen
    ></iframe>

    <div class="p-5 sm:p-6 md:col-span-2 md:flex md:flex-col">
      <div>
        <div class="text-xs font-semibold uppercase tracking-wider text-slate-500">Адрес</div>
        <div class="mt-1 text-lg font-bold text-slate-900">{site.address}</div>
      </div>
      <div class="mt-4">
        <div class="text-xs font-semibold uppercase tracking-wider text-slate-500">Режим работы</div>
        <div class="mt-1 font-bold text-slate-900">9:00–19:00, без выходных</div>
      </div>

      <div class="mt-6 flex flex-col gap-2 sm:flex-row md:mt-auto">
        <a
          href={site.route.web}
          data-scheme={site.route.scheme}
          data-intent={site.route.intent}
          data-goal="route"
          class="route-btn inline-flex items-center justify-center gap-2 rounded-2xl bg-blue-600 px-6 py-3 font-bold text-white transition hover:bg-blue-700 sm:flex-1"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 11 19-9-9 19-2-8-8-2Z"/></svg>
          Маршрут
        </a>
        <a
          href="/kontakty/"
          class="inline-flex items-center justify-center rounded-2xl border border-slate-300 bg-white px-6 py-3 font-semibold text-slate-700 transition hover:border-blue-400 hover:text-blue-600 sm:flex-1"
        >Все контакты</a>
      </div>
    </div>
  </div>
</section>
