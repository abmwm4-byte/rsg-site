---
import { site } from '../data/site';
import RouteButton from './RouteButton.astro';

const mapsFrame = `https://yandex.by/map-widget/v1/?display-text=${encodeURIComponent('Ремонт стартеров и генераторов')}&ll=${site.geo.lng}%2C${site.geo.lat}&mode=search&poi%5Bpoint%5D=${site.geo.lng}%2C${site.geo.lat}&poi%5Buri%5D=ymapsbm1%3A%2F%2Forg%3Foid%3D151564311231&z=16`;
---

<section class="mx-auto max-w-6xl px-4 py-16">
  <h2 class="mb-8 text-3xl font-extrabold tracking-tight text-slate-900">Как нас найти</h2>
  <div class="grid gap-6 md:grid-cols-5">
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white md:col-span-3">
      <iframe
        src={mapsFrame}
        title="Карта: автосервис RSG Group, Минск"
        class="h-72 w-full"
        loading="lazy"
        allowfullscreen
      ></iframe>
    </div>
    <div class="flex flex-col justify-between gap-4 rounded-2xl border border-slate-200 bg-white p-6 md:col-span-2">
      <div>
        <div class="text-sm font-semibold uppercase tracking-wide text-slate-500">Адрес</div>
        <div class="mt-1 text-lg font-bold text-slate-900">{site.address}</div>
        <div class="mt-3 text-sm font-semibold uppercase tracking-wide text-slate-500">Режим работы</div>
        <div class="mt-1 font-bold text-slate-900">9:00–19:00, без выходных</div>
      </div>
      <div class="flex flex-wrap gap-2">
        <RouteButton variant="primary" />
        <a href="/kontakty/" class="rounded-2xl border border-slate-300 bg-white px-6 py-3 font-semibold text-slate-700 transition hover:border-blue-400 hover:text-blue-600">Все контакты</a>
      </div>
    </div>
  </div>
</section>
