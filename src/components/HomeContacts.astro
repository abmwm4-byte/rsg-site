---
import { site } from '../data/site';

// Статичная карта вместо живого iframe: ноль JS — быстрый скролл главной.
// Интерактивная карта осталась на странице «Контакты».
const staticMap = 'https://static-maps.yandex.ru/1.x/?ll=27.478593%2C53.891673&z=16&size=650%2C400&l=map&pt=27.478593%2C53.891673%2Cpm2rdl';
---

<section class="cv-auto mx-auto max-w-6xl px-4 py-16">
  <h2 class="mb-8 text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">Как нас найти</h2>

  <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-800 md:grid md:grid-cols-5">
    <a
      href={site.route.web}
      data-goal="route"
      aria-label="Открыть карточку RSG Group в Яндекс Картах"
      class="group relative block md:col-span-3"
    >
      <img
        src={staticMap}
        alt="Карта проезда: RSG Group, Минск, 2-й Короткий пер., 23"
        width="650"
        height="400"
        loading="lazy"
        class="h-52 w-full object-cover sm:h-64 md:h-full"
      />
      <span class="absolute bottom-3 right-3 rounded-xl bg-white/95 px-3 py-1.5 text-xs font-bold text-blue-700 shadow transition group-hover:bg-blue-600 group-hover:text-white">Открыть в Яндекс.Картах →</span>
    </a>

    <div class="p-5 sm:p-6 md:col-span-2 md:flex md:flex-col">
      <div>
        <div class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Адрес</div>
        <div class="mt-1 text-lg font-bold text-slate-900 dark:text-white">{site.address}</div>
      </div>
      <div class="mt-4">
        <div class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Режим работы</div>
        <div class="mt-1 font-bold text-slate-900 dark:text-white">9:00–19:00, без выходных</div>
      </div>

      <div class="mt-6 flex flex-col gap-2 sm:flex-row md:mt-auto">
        <a
          href={site.route.web}
          data-goal="route"
          class="route-btn inline-flex items-center justify-center gap-2 rounded-2xl bg-blue-600 px-6 py-3 font-bold text-white transition hover:bg-blue-700 sm:flex-1"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon><line x1="8" y1="2" x2="8" y2="18"></line><line x1="16" y1="6" x2="16" y2="22"></line></svg>
          Маршрут
        </a>
        <a
          href="/kontakty/"
          class="inline-flex items-center justify-center rounded-2xl border border-slate-300 bg-white px-6 py-3 font-semibold text-slate-700 transition hover:border-blue-400 hover:text-blue-600 dark:border-slate-600 dark:bg-slate-800 dark:text-slate-200 dark:hover:border-blue-500 dark:hover:text-blue-400 sm:flex-1"
        >Все контакты</a>
      </div>
    </div>
  </div>
</section>
