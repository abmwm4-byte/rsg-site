---
import { site, nav } from '../data/site';
---

<footer class="border-t border-slate-200 bg-white pb-[max(7rem,calc(6rem+env(safe-area-inset-bottom)))] md:pb-0 dark:border-slate-800 dark:bg-slate-900">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 text-sm text-slate-500 dark:text-slate-400 md:grid-cols-3">
    <div>
      <div class="text-lg font-extrabold text-slate-900 dark:text-white">RSG <span class="text-blue-600 dark:text-blue-400">Group</span></div>
      <p class="mt-3">{site.address}</p>
      <p class="mt-1">{site.hours}</p>
    </div>
    <div>
      <div class="font-semibold text-slate-900 dark:text-white">Контакты</div>
      {site.phones.map((p) => (
        <p class="mt-2">
          <a href={p.href} data-goal="call" class="font-medium text-slate-700 transition hover:text-blue-600 dark:text-slate-300 dark:hover:text-blue-400">{p.label}: {p.number}</a>
        </p>
      ))}
      <p class="mt-3 flex gap-3">
        {site.messengers.map((m) => (
          <a href={m.href} data-goal={m.goal} class="font-medium text-blue-600 transition hover:underline dark:text-blue-400">{m.name}</a>
        ))}
      </p>
    </div>
    <div>
      <div class="font-semibold text-slate-900 dark:text-white">Услуги</div>
      {nav.slice(0, 4).map((item) => (
        <p class="mt-2"><a href={item.href} class="transition hover:text-blue-600 dark:hover:text-blue-400">{item.label}</a></p>
      ))}
    </div>
  </div>
  <div class="border-t border-slate-100 dark:border-slate-800">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-2 px-4 py-4 text-xs text-slate-500 dark:text-slate-400">
      <p>© 2010–2026 {site.legalName}. УНП: {site.unp}. Все права защищены.</p>
      <p id="online-counter" class="hidden items-center gap-1.5">
        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-500"></span>
        <span>Сейчас на сайте: <b id="online-count">—</b></span>
      </p>
    </div>
  </div>
</footer>

<script is:inline>
  // Счётчик онлайна: опрашиваем /api/online, обновляем каждые 60 сек
  (() => {
    const box = document.getElementById('online-counter');
    const num = document.getElementById('online-count');
    if (!box || !num) return;
    const tick = async () => {
      try {
        const r = await fetch('/api/online');
        const d = await r.json();
        num.textContent = d.online;
        box.classList.remove('hidden');
        box.classList.add('flex');
      } catch {}
    };
    tick();
    setInterval(tick, 60000);
  })();
</script>
