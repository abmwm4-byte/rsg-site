---
import { site, nav } from '../data/site';
import OpenStatus from './OpenStatus.astro';

const path = Astro.url.pathname;
---

<div class="bg-blue-700 text-sm text-blue-50">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-2">
    <span class="hidden sm:block">{site.address}</span>
    <span class="sm:hidden">{site.addressShort}</span>
    <OpenStatus />
  </div>
</div>

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
    <a href="/" class="text-2xl font-extrabold tracking-tight text-slate-900">RSG <span class="text-blue-600">Group</span></a>
    <nav class="hidden gap-7 text-sm font-medium md:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'transition hover:text-blue-600',
            path.startsWith(item.href) ? 'font-semibold text-blue-600' : 'text-slate-600',
          ]}
        >{item.label}</a>
      ))}
    </nav>
    <a
      href={site.phones[0].href}
      data-goal="call"
      class="hidden rounded-xl bg-blue-600 px-5 py-2.5 font-semibold text-white shadow-sm transition hover:bg-blue-700 md:block"
    >{site.phones[0].number}</a>
    <details class="relative md:hidden">
      <summary class="list-none rounded-xl border border-slate-300 p-2.5 text-slate-700 [&::-webkit-details-marker]:hidden" aria-label="Меню">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </summary>
      <nav class="absolute right-0 mt-2 flex w-56 flex-col rounded-2xl border border-slate-200 bg-white p-2 shadow-xl">
        {nav.map((item) => (
          <a href={item.href} class="rounded-xl px-4 py-3 text-sm font-medium text-slate-700 transition hover:bg-slate-50 hover:text-blue-600">{item.label}</a>
        ))}
      </nav>
    </details>
  </div>
</header>
