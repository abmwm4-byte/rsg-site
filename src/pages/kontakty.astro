---
import SiteLayout from '../layouts/SiteLayout.astro';
import MessengerButtons from '../components/MessengerButtons.astro';
import RouteButton from '../components/RouteButton.astro';
import { site } from '../data/site';

const mapsBase = `https://yandex.by/map-widget/v1/?display-text=${encodeURIComponent('Ремонт стартеров и генераторов')}&ll=${site.geo.lng}%2C${site.geo.lat}&mode=search&poi%5Bpoint%5D=${site.geo.lng}%2C${site.geo.lat}&poi%5Buri%5D=ymapsbm1%3A%2F%2Forg%3Foid%3D151564311231&z=16`;
const mapsLight = mapsBase + '&theme=light';
const mapsDark = mapsBase + '&theme=dark';
---

<SiteLayout
  title="Контакты — автосервис RSG Group, Минск, 2-й Короткий пер. 23"
  description="Автосервис RSG Group: г. Минск, 2-й Короткий пер., 23. Работаем без выходных с 9:00 до 19:00. Телефоны А1 и МТС, Viber, Telegram, WhatsApp. Как проехать."
>
  <section class="bg-white dark:bg-slate-900">
    <div class="mx-auto max-w-6xl px-4 pb-12 pt-12">
      <nav class="mb-4 text-sm text-slate-500 dark:text-slate-400"><a href="/" class="hover:text-blue-600">Главная</a> / <span class="text-slate-700">Контакты</span></nav>
      <h1 class="text-4xl font-extrabold leading-tight tracking-tight text-slate-900 dark:text-white md:text-5xl">Контакты</h1>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="grid gap-8 md:grid-cols-2">
      <!-- Карточка контактов -->
      <div class="space-y-6">
        <div class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-800">
          <div class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Адрес</div>
          <div class="mt-2 text-xl font-bold text-slate-900 dark:text-white">{site.address}</div>
          <div class="mt-3"><RouteButton variant="primary" /></div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-800">
          <div class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Режим работы</div>
          <div class="mt-2 text-xl font-bold text-slate-900 dark:text-white">9:00–19:00</div>
          <div class="text-slate-600">Без выходных</div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-800">
          <div class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Телефоны</div>
          {site.phones.map((p) => (
            <a href={p.href} data-goal="call" class="mt-2 block text-xl font-bold text-slate-900 dark:text-white transition hover:text-blue-600">
              {p.label}: {p.number}
            </a>
          ))}
          <div class="mt-4">
            <div class="mb-2 text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Мессенджеры</div>
            <MessengerButtons />
          </div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-800 text-sm text-slate-500 dark:text-slate-400">
          {site.legalName} · УНП: {site.unp}
        </div>
        <figure class="overflow-hidden rounded-2xl border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-800">
          <img src="/images/exterior.jpg" alt="Вход в автосервис RSG Group — вывеска «Стартеры и генераторы»" loading="lazy" width="1200" height="900" class="aspect-[4/3] w-full object-cover" />
          <figcaption class="px-6 py-4 text-sm text-slate-600 dark:text-slate-400">Так выглядит наш вход — ориентируйтесь на светящуюся вывеску</figcaption>
        </figure>
      </div>

      <!-- Карта -->
      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-800">
        <iframe
          src={mapsLight}
          data-light={mapsLight}
          data-dark={mapsDark}
          title="Карта: автосервис RSG Group, Минск"
          class="yandex-map h-full min-h-[400px] w-full"
          loading="lazy"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>
</SiteLayout>
