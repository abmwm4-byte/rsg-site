---
import Base from '../layouts/Base.astro';
import { site, services, advantages } from '../data/site';
---

<Base title="Концепт C — Гараж | RSG Group" description="Дизайн-концепт C" noindex>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Russo+One&display=swap" rel="stylesheet" />

  <div class="min-h-screen bg-zinc-900 font-[Inter] text-zinc-200 antialiased">
    <!-- Верхняя полоса -->
    <div class="border-b-2 border-yellow-400 bg-zinc-950 text-xs font-semibold uppercase tracking-widest text-yellow-400">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-2">
        <span>{site.address}</span>
        <span class="hidden sm:block">{site.hours}</span>
      </div>
    </div>

    <!-- Шапка -->
    <header class="sticky top-0 z-40 border-b-2 border-zinc-700 bg-zinc-900/95 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
        <a href="#" class="font-[Russo_One] text-2xl uppercase text-white">RSG<span class="text-yellow-400">//</span>GROUP</a>
        <nav class="hidden gap-6 text-sm font-bold uppercase tracking-wider text-zinc-400 md:flex">
          <a href="#" class="transition hover:text-yellow-400">Услуги</a>
          <a href="#" class="transition hover:text-yellow-400">Цены</a>
          <a href="#" class="transition hover:text-yellow-400">Регионы</a>
          <a href="#" class="transition hover:text-yellow-400">Контакты</a>
        </nav>
        <a href={site.phones[0].href} class="hidden border-2 border-yellow-400 px-4 py-2 font-[Russo_One] text-yellow-400 transition hover:bg-yellow-400 hover:text-zinc-900 md:block">{site.phones[0].number}</a>
      </div>
    </header>

    <!-- Hero -->
    <section class="relative overflow-hidden border-b-2 border-zinc-700">
      <div class="pointer-events-none absolute inset-0 opacity-10" style="background-image:repeating-linear-gradient(-45deg,#facc15 0 2px,transparent 2px 18px)"></div>
      <div class="relative mx-auto max-w-6xl px-4 pb-20 pt-16 md:pt-24">
        <p class="mb-5 inline-block bg-yellow-400 px-3 py-1 font-[Russo_One] text-xs uppercase tracking-widest text-zinc-900">СТО · Минск · 10 лет</p>
        <h1 class="max-w-3xl font-[Russo_One] text-4xl uppercase leading-[1.1] text-white md:text-6xl">
          Стартер сдох? <span class="text-yellow-400">Генератор не заряжает?</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg text-zinc-400">Приезжай — разберём, починим, проверим на стенде. Свой склад запчастей: большинство ремонтов — в день обращения.</p>
        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a href={site.phones[0].href} class="bg-yellow-400 px-8 py-4 font-[Russo_One] text-lg uppercase text-zinc-900 shadow-[6px_6px_0_#52525b] transition hover:translate-x-0.5 hover:translate-y-0.5 hover:shadow-[3px_3px_0_#52525b]">Позвонить</a>
          <div class="flex gap-2">
            {site.messengers.map((m) => (
              <a href={m.href} class="border-2 border-zinc-600 px-4 py-4 text-sm font-bold uppercase text-zinc-300 transition hover:border-yellow-400 hover:text-yellow-400">{m.name}</a>
            ))}
          </div>
        </div>
        <div class="mt-14 grid grid-cols-2 gap-4 md:grid-cols-4">
          {advantages.map((a) => (
            <div class="border-2 border-zinc-700 bg-zinc-950 p-5">
              <div class="font-[Russo_One] uppercase text-yellow-400">{a.title}</div>
              <div class="mt-2 text-sm text-zinc-500">{a.text}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Услуги -->
    <section class="mx-auto max-w-6xl px-4 py-16">
      <h2 class="mb-2 font-[Russo_One] text-3xl uppercase text-white">Что чиним и сколько стоит</h2>
      <p class="mb-10 text-sm uppercase tracking-widest text-zinc-500">точную цену назовём после осмотра</p>
      <div class="grid gap-5 md:grid-cols-3">
        {services.map((s) => (
          <a href={s.href} class="group border-2 border-zinc-700 bg-zinc-950 p-6 shadow-[6px_6px_0_#27272a] transition hover:border-yellow-400">
            <h3 class="font-[Russo_One] text-lg uppercase text-white group-hover:text-yellow-400">{s.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-zinc-400">{s.description}</p>
            <div class="mt-6 flex items-center justify-between border-t-2 border-zinc-800 pt-4">
              <span class="font-[Russo_One] text-2xl text-yellow-400">{s.priceFrom}</span>
              <span class="text-xs font-bold uppercase text-zinc-500">{s.time}</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Отзывы -->
    <section class="border-y-2 border-zinc-700 bg-zinc-950">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-8 px-4 py-16">
        <div class="border-2 border-yellow-400 px-6 py-4 font-[Russo_One] text-6xl text-yellow-400">{site.rating.value}</div>
        <div>
          <div class="font-[Russo_One] text-xl uppercase text-white">{site.rating.reviewsCount} отзывов на {site.rating.source}</div>
          <p class="mt-2 text-zinc-400">Скорость, честные цены, гарантия. Проверь сам.</p>
          <a href="#" class="mt-3 inline-block font-bold uppercase tracking-wider text-yellow-400 hover:underline">Читать отзывы →</a>
        </div>
      </div>
    </section>

    <!-- Регионы -->
    <section class="mx-auto max-w-6xl px-4 py-16">
      <h2 class="max-w-2xl font-[Russo_One] text-3xl uppercase text-white">Не из Минска? <span class="text-yellow-400">Шли Европочтой</span></h2>
      <p class="mt-4 max-w-xl text-zinc-400">Отправляешь стартер или генератор — мы чиним и отправляем обратно. Вся Беларусь.</p>
      <a href="/dlya-regionov/" class="mt-8 inline-block border-2 border-yellow-400 px-6 py-3 font-[Russo_One] uppercase text-yellow-400 transition hover:bg-yellow-400 hover:text-zinc-900">Как это работает</a>
    </section>

    <!-- Футер -->
    <footer class="border-t-2 border-zinc-700 bg-zinc-950">
      <div class="mx-auto max-w-6xl px-4 py-10 text-sm text-zinc-500">
        <div class="font-[Russo_One] text-lg uppercase text-white">RSG<span class="text-yellow-400">//</span>GROUP</div>
        <p class="mt-3">{site.address} · {site.hours}</p>
        <p class="mt-1">{site.phones.map(p => `${p.label}: ${p.number}`).join(' · ')}</p>
        <p class="mt-4 text-xs">© 2010–2026 {site.legalName}. УНП: {site.unp}</p>
      </div>
    </footer>

    <!-- Липкая панель CTA (мобильная) -->
    <div class="fixed bottom-0 z-50 flex w-full gap-2 border-t-2 border-zinc-700 bg-zinc-900/95 p-3 backdrop-blur md:hidden">
      <a href={site.phones[0].href} class="flex-1 bg-yellow-400 py-3 text-center font-[Russo_One] uppercase text-zinc-900">Позвонить</a>
      {site.messengers.slice(0, 2).map((m) => (
        <a href={m.href} class="border-2 border-zinc-600 px-4 py-3 text-sm font-bold uppercase text-zinc-300">{m.name}</a>
      ))}
    </div>
  </div>
</Base>
