---
import SiteLayout from '../../layouts/SiteLayout.astro';
import MessengerButtons from '../../components/MessengerButtons.astro';
import { site, symptoms } from '../../data/site';
---

<SiteLayout
  title="Симптомы неисправностей стартера и генератора — причины и цены | RSG Group, Минск"
  description="Стартер щёлкает, но не крутит? Горит лампочка аккумулятора? Разбираем частые симптомы: причины, цены ремонта, реальные кейсы. Минск, гарантия 3 месяца."
>
  <section class="bg-white dark:bg-slate-900">
    <div class="mx-auto max-w-6xl px-4 pb-12 pt-12">
      <nav class="mb-4 text-sm text-slate-500 dark:text-slate-400"><a href="/" class="hover:text-blue-600">Главная</a> / <span class="text-slate-700 dark:text-slate-300">Симптомы</span></nav>
      <h1 class="max-w-2xl text-4xl font-extrabold leading-tight tracking-tight text-slate-900 dark:text-white md:text-5xl">Симптомы: стартер и генератор</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-600 dark:text-slate-400">
        Частые неисправности простым языком: что случилось, почему и во сколько обойдётся ремонт.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="grid gap-5 md:grid-cols-2">
      {symptoms.map((s) => (
        <a href={`/simptomy/${s.slug}/`} class="group rounded-3xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-xl dark:border-slate-700 dark:bg-slate-800">
          <div class="flex items-center gap-2">
            <span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold text-blue-700 dark:bg-blue-950 dark:text-blue-300">{s.unit}</span>
          </div>
          <h2 class="mt-3 text-xl font-bold text-slate-900 dark:text-white group-hover:text-blue-600">{s.title}</h2>
          <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{s.cause}</p>
          <div class="mt-4 border-t border-slate-100 pt-4 text-sm dark:border-slate-700">
            <span class="font-extrabold text-blue-700 dark:text-blue-400">{s.priceMin}–{s.priceMax} BYN</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-white dark:bg-slate-900">
    <div class="mx-auto max-w-6xl px-4 py-16 text-center">
      <h2 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">Не нашли свой симптом?</h2>
      <p class="mx-auto mt-3 max-w-xl text-slate-600 dark:text-slate-400">Опишите проблему по телефону или в мессенджере — подскажем, что это может быть. Приезжайте без записи: {site.hours}.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={site.phones[0].href} data-goal="call" class="rounded-2xl bg-blue-600 px-8 py-4 text-lg font-bold text-white shadow-lg shadow-blue-600/25 transition hover:bg-blue-700">Позвонить</a>
        <MessengerButtons size="lg" />
      </div>
    </div>
  </section>
</SiteLayout>
