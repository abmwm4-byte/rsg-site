---
import Base from '../layouts/Base.astro';
import { site, services, advantages } from '../data/site';
---

<Base title="Концепт B — Чистый сервис | RSG Group" description="Дизайн-концепт B" noindex>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <div class="min-h-screen bg-slate-50 font-[Inter] text-slate-800 antialiased">
    <!-- Верхняя полоса -->
    <div class="bg-blue-700 text-sm text-blue-50">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-2">
        <span>{site.address}</span>
        <span class="hidden sm:block">{site.hours}</span>
      </div>
    </div>

    <!-- Шапка -->
    <header class="sticky top-0 z-40 border-b border-slate-200 bg-white/90 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
        <a href="#" class="text-2xl font-extrabold tracking-tight text-slate-900">RSG <span class="text-blue-600">Group</span></a>
        <nav class="hidden gap-7 text-sm font-medium text-slate-600 md:flex">
          <a href="#" class="transition hover:text-blue-600">Услуги</a>
          <a href="#" class="transition hover:text-blue-600">Цены</a>
          <a href="#" class="transition hover:text-blue-600">Для регионов</a>
          <a href="#" class="transition hover:text-blue-600">Контакты</a>
        </nav>
        <a href={site.phones[0].href} class="hidden rounded-xl bg-blue-600 px-5 py-2.5 font-semibold text-white shadow-sm transition hover:bg-blue-700 md:block">{site.phones[0].number}</a>
      </div>
    </header>

    <!-- Hero -->
    <section class="bg-white">
      <div class="mx-auto max-w-6xl px-4 pb-16 pt-14 md:pt-20">
        <div class="max-w-2xl">
          <p class="mb-4 inline-block rounded-full bg-blue-50 px-4 py-1.5 text-sm font-semibold text-blue-700">Минск · работаем без выходных</p>
          <h1 class="text-4xl font-extrabold leading-tight tracking-tight text-slate-900 md:text-5xl">
            Ремонт стартеров и&nbsp;генераторов в Минске
          </h1>
          <p class="mt-5 text-lg leading-relaxed text-slate-600">Узкая специализация, свой склад запчастей и стенд проверки. Осмотр автомобиля в день обращения — без очередей и записи за неделю.</p>
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <a href={site.phones[0].href} class="rounded-2xl bg-blue-600 px-8 py-4 text-lg font-bold text-white shadow-lg shadow-blue-600/25 transition hover:bg-blue-700">Позвонить</a>
            {site.messengers.map((m) => (
              <a href={m.href} class="rounded-2xl border border-slate-300 bg-white px-5 py-4 font-semibold text-slate-700 transition hover:border-blue-400 hover:text-blue-600">{m.name}</a>
            ))}
          </div>
        </div>
        <div class="mt-12 grid grid-cols-2 gap-4 md:grid-cols-4">
          {advantages.map((a) => (
            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
              <div class="font-bold text-slate-900">{a.title}</div>
              <div class="mt-1 text-sm leading-snug text-slate-500">{a.text}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Услуги -->
    <section class="mx-auto max-w-6xl px-4 py-16">
      <div class="mb-10 text-center">
        <h2 class="text-3xl font-extrabold tracking-tight text-slate-900">Услуги и цены</h2>
        <p class="mt-2 text-slate-500">Точную стоимость называем после бесплатного осмотра</p>
      </div>
      <div class="grid gap-5 md:grid-cols-3">
        {services.map((s) => (
          <a href={s.href} class="group rounded-3xl border border-slate-200 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-xl">
            <h3 class="text-xl font-bold text-slate-900 group-hover:text-blue-600">{s.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">{s.description}</p>
            <div class="mt-6 flex items-center justify-between">
              <span class="text-2xl font-extrabold text-blue-600">{s.priceFrom}</span>
              <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-500">{s.time}</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Отзывы -->
    <section class="bg-white">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-8 px-4 py-16">
        <div class="flex h-24 w-24 items-center justify-center rounded-3xl bg-amber-100 text-4xl font-extrabold text-amber-600">{site.rating.value}</div>
        <div>
          <div class="text-xl font-bold text-slate-900">{site.rating.reviewsCount} отзывов на {site.rating.source}</div>
          <p class="mt-1 text-slate-600">Клиенты отмечают скорость, честные цены и гарантию на работы.</p>
          <a href="#" class="mt-2 inline-block font-semibold text-blue-600 hover:underline">Читать отзывы →</a>
        </div>
      </div>
    </section>

    <!-- Регионы -->
    <section class="mx-auto max-w-6xl px-4 py-16">
      <div class="rounded-3xl bg-gradient-to-br from-blue-700 to-blue-900 p-10 text-white md:p-14">
        <h2 class="max-w-xl text-3xl font-extrabold tracking-tight">Не из Минска? Отправьте узел Европочтой</h2>
        <p class="mt-3 max-w-lg text-blue-100">Вы отправляете стартер или генератор — мы ремонтируем и возвращаем. Работаем со всей Беларусью.</p>
        <a href="/dlya-regionov/" class="mt-7 inline-block rounded-2xl bg-white px-6 py-3 font-bold text-blue-700 transition hover:bg-blue-50">Как это работает</a>
      </div>
    </section>

    <!-- Футер -->
    <footer class="border-t border-slate-200 bg-white">
      <div class="mx-auto max-w-6xl px-4 py-10 text-sm text-slate-500">
        <div class="text-lg font-extrabold text-slate-900">RSG <span class="text-blue-600">Group</span></div>
        <p class="mt-3">{site.address} · {site.hours}</p>
        <p class="mt-1">{site.phones.map(p => `${p.label}: ${p.number}`).join(' · ')}</p>
        <p class="mt-4 text-xs">© 2010–2026 {site.legalName}. УНП: {site.unp}</p>
      </div>
    </footer>

    <!-- Липкая панель CTA (мобильная) -->
    <div class="fixed bottom-0 z-50 flex w-full gap-2 border-t border-slate-200 bg-white/95 p-3 backdrop-blur md:hidden">
      <a href={site.phones[0].href} class="flex-1 rounded-xl bg-blue-600 py-3 text-center font-bold text-white">Позвонить</a>
      {site.messengers.slice(0, 2).map((m) => (
        <a href={m.href} class="rounded-xl border border-slate-300 px-4 py-3 text-sm font-semibold text-slate-700">{m.name}</a>
      ))}
    </div>
  </div>
</Base>
