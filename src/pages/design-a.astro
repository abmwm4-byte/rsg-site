---
import Base from '../layouts/Base.astro';
import { site, services, advantages } from '../data/site';
---

<Base title="Концепт A — Техно | RSG Group" description="Дизайн-концепт A" noindex>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Oswald:wght@500;600;700&display=swap" rel="stylesheet" />

  <div class="min-h-screen bg-[#0c0f14] font-[Inter] text-slate-200 antialiased">
    <!-- Верхняя полоса -->
    <div class="border-b border-white/10 bg-black/40 text-xs">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-2">
        <span class="tracking-wide text-slate-400">{site.address}</span>
        <span class="hidden tracking-wide text-slate-400 sm:block">{site.hours}</span>
        <span class="font-semibold text-amber-400">Открыто до 19:00</span>
      </div>
    </div>

    <!-- Шапка -->
    <header class="sticky top-0 z-40 border-b border-white/10 bg-[#0c0f14]/90 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
        <a href="#" class="font-[Oswald] text-2xl font-bold tracking-widest text-white">RSG<span class="text-amber-400">GROUP</span></a>
        <nav class="hidden gap-8 text-sm text-slate-300 md:flex">
          <a href="#" class="transition hover:text-amber-400">Услуги</a>
          <a href="#" class="transition hover:text-amber-400">Цены</a>
          <a href="#" class="transition hover:text-amber-400">Для регионов</a>
          <a href="#" class="transition hover:text-amber-400">Контакты</a>
        </nav>
        <a href={site.phones[0].href} class="hidden font-[Oswald] text-lg font-semibold tracking-wider text-white transition hover:text-amber-400 md:block">{site.phones[0].number}</a>
      </div>
    </header>

    <!-- Hero -->
    <section class="relative overflow-hidden">
      <div class="pointer-events-none absolute inset-0 opacity-[0.15]" style="background-image:linear-gradient(rgba(255,255,255,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.06) 1px,transparent 1px);background-size:48px 48px"></div>
      <div class="relative mx-auto max-w-6xl px-4 pb-20 pt-16 md:pt-24">
        <p class="mb-4 inline-block border border-amber-400/40 bg-amber-400/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-amber-400">Минск · СТО с 2015 года</p>
        <h1 class="max-w-3xl font-[Oswald] text-4xl font-bold uppercase leading-[1.05] tracking-wide text-white md:text-6xl">
          Ремонт стартеров и&nbsp;генераторов
        </h1>
        <p class="mt-6 max-w-xl text-lg text-slate-400">Узкая специализация, собственный склад запчастей и стенд проверки. Большинство ремонтов — в день обращения.</p>
        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a href={site.phones[0].href} class="bg-amber-400 px-8 py-4 font-[Oswald] text-lg font-semibold uppercase tracking-wider text-black transition hover:bg-amber-300">Позвонить</a>
          <div class="flex gap-2">
            {site.messengers.map((m) => (
              <a href={m.href} class="border border-white/20 px-4 py-4 text-sm font-medium text-slate-200 transition hover:border-amber-400 hover:text-amber-400">{m.name}</a>
            ))}
          </div>
        </div>
        <div class="mt-14 grid grid-cols-2 gap-px bg-white/10 md:grid-cols-4">
          {advantages.map((a) => (
            <div class="bg-[#0c0f14] p-5">
              <div class="font-[Oswald] text-lg font-semibold uppercase tracking-wide text-white">{a.title}</div>
              <div class="mt-1 text-sm text-slate-500">{a.text}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Услуги -->
    <section class="border-t border-white/10 bg-[#10141b]">
      <div class="mx-auto max-w-6xl px-4 py-16">
        <div class="mb-10 flex items-end justify-between">
          <h2 class="font-[Oswald] text-3xl font-bold uppercase tracking-wide text-white">Услуги и цены</h2>
          <span class="text-xs uppercase tracking-widest text-slate-500">точную цену назовём после диагностики</span>
        </div>
        <div class="grid gap-4 md:grid-cols-3">
          {services.map((s) => (
            <a href={s.href} class="group border border-white/10 bg-[#0c0f14] p-6 transition hover:border-amber-400/60">
              <h3 class="font-[Oswald] text-xl font-semibold uppercase tracking-wide text-white group-hover:text-amber-400">{s.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-slate-400">{s.description}</p>
              <div class="mt-6 flex items-center justify-between border-t border-white/10 pt-4">
                <span class="font-[Oswald] text-2xl font-semibold text-amber-400">{s.priceFrom}</span>
                <span class="text-xs text-slate-500">{s.time}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Отзывы -->
    <section class="border-t border-white/10">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-8 px-4 py-16">
        <div class="font-[Oswald] text-7xl font-bold text-amber-400">{site.rating.value}</div>
        <div>
          <div class="text-xl font-semibold text-white">{site.rating.reviewsCount} отзывов на {site.rating.source}</div>
          <p class="mt-1 text-slate-400">Клиенты отмечают скорость, честные цены и гарантию на работы.</p>
          <a href="#" class="mt-3 inline-block text-sm font-semibold text-amber-400 underline-offset-4 hover:underline">Читать отзывы →</a>
        </div>
      </div>
    </section>

    <!-- Регионы -->
    <section class="border-t border-white/10 bg-[#10141b]">
      <div class="mx-auto max-w-6xl px-4 py-16">
        <h2 class="max-w-2xl font-[Oswald] text-3xl font-bold uppercase tracking-wide text-white">Не из Минска? Отправьте узел Европочтой</h2>
        <p class="mt-4 max-w-xl text-slate-400">Вы отправляете стартер или генератор — мы ремонтируем и возвращаем. Работаем со всей Беларусью.</p>
        <a href="/dlya-regionov/" class="mt-8 inline-block border border-amber-400 px-6 py-3 font-[Oswald] font-semibold uppercase tracking-wider text-amber-400 transition hover:bg-amber-400 hover:text-black">Как это работает</a>
      </div>
    </section>

    <!-- Футер -->
    <footer class="border-t border-white/10 bg-black/40">
      <div class="mx-auto max-w-6xl px-4 py-10 text-sm text-slate-500">
        <div class="font-[Oswald] text-lg tracking-widest text-white">RSG<span class="text-amber-400">GROUP</span></div>
        <p class="mt-3">{site.address} · {site.hours}</p>
        <p class="mt-1">{site.phones.map(p => `${p.label}: ${p.number}`).join(' · ')}</p>
        <p class="mt-4 text-xs">© 2010–2026 {site.legalName}. УНП: {site.unp}</p>
      </div>
    </footer>

    <!-- Липкая панель CTA (мобильная) -->
    <div class="fixed bottom-0 z-50 flex w-full gap-2 border-t border-white/10 bg-[#0c0f14]/95 p-3 backdrop-blur md:hidden">
      <a href={site.phones[0].href} class="flex-1 bg-amber-400 py-3 text-center font-[Oswald] font-semibold uppercase tracking-wider text-black">Позвонить</a>
      {site.messengers.slice(0, 2).map((m) => (
        <a href={m.href} class="border border-white/20 px-4 py-3 text-sm text-slate-200">{m.name}</a>
      ))}
    </div>
  </div>
</Base>
