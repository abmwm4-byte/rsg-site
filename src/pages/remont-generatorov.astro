---
import SiteLayout from '../layouts/SiteLayout.astro';
import Faq from '../components/Faq.astro';
import MessengerButtons from '../components/MessengerButtons.astro';
import RouteButton from '../components/RouteButton.astro';
import RegionBlock from '../components/RegionBlock.astro';
import { site, generatorSymptoms, generatorFaq } from '../data/site';
---

<SiteLayout
  title="Ремонт генераторов в Минске — от 50 BYN, в день обращения | RSG Group"
  description="Ремонт генераторов любой сложности в Минске: замена подшипников, диодного моста, регулятора напряжения, щёток. Проверка на стенде под нагрузкой, гарантия. Работаем без выходных 9:00–19:00."
>
  <!-- Hero страницы -->
  <section class="bg-white dark:bg-slate-900">
    <div class="mx-auto max-w-6xl px-4 pb-12 pt-12">
      <nav class="mb-4 text-sm text-slate-500 dark:text-slate-400"><a href="/" class="hover:text-blue-600">Главная</a> / <span class="text-slate-700">Ремонт генераторов</span></nav>
      <h1 class="max-w-2xl text-4xl font-extrabold leading-tight tracking-tight text-slate-900 dark:text-white md:text-5xl">Ремонт генераторов в Минске</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-600 dark:text-slate-400">
        Замена подшипников, диодного моста, регулятора напряжения, щёток. Проверка на стенде под нагрузкой.
        Большинство работ — в день обращения, благодаря собственному складу запчастей.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href={site.phones[0].href} data-goal="call" class="rounded-2xl bg-blue-600 px-6 py-4 text-base font-bold text-white shadow-lg shadow-blue-600/25 transition hover:bg-blue-700 sm:px-8 sm:text-lg">{site.phones[0].number}</a>
        <RouteButton size="lg" />
        <MessengerButtons size="lg" />
      </div>
    </div>
  </section>

  <!-- Симптомы -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="mb-8 text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">Когда пора к нам</h2>
    <div class="grid gap-4 md:grid-cols-2">
      {generatorSymptoms.map((s) => (
        <div class="flex items-start gap-3 rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-800">
          <svg class="mt-0.5 h-5 w-5 shrink-0 text-blue-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 9v4m0 4h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg>
          <span class="text-slate-700">{s}</span>
        </div>
      ))}
    </div>
    <p class="mt-6 rounded-2xl bg-blue-50 p-5 text-slate-700 dark:bg-blue-950/50 dark:text-slate-300">
      Горит лампочка аккумулятора? Это не всегда генератор — причина может быть в проводке или ремне. Диагностика покажет точно.
    </p>
  </section>

  <!-- Цены -->
  <section class="bg-white dark:bg-slate-900">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <h2 class="mb-8 text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">Цены на ремонт генераторов</h2>
      <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-700">
        <table class="w-full text-left">
          <thead class="bg-slate-50 text-sm font-semibold text-slate-600 dark:bg-slate-800 dark:text-slate-400">
            <tr><th class="px-6 py-4">Работа</th><th class="px-6 py-4">Стоимость</th><th class="hidden px-6 py-4 sm:table-cell">Срок</th></tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
            <!-- TODO(прайс): заменить на реальные цены -->
            <tr><td class="px-6 py-4 font-medium text-slate-900 dark:text-white">Диагностика на стенде</td><td class="px-6 py-4 text-blue-700 font-bold dark:text-blue-400">от 20 BYN</td><td class="hidden px-6 py-4 text-slate-500 dark:text-slate-400 sm:table-cell">20–30 мин</td></tr>
            <tr><td class="px-6 py-4 font-medium text-slate-900 dark:text-white">Замена щёток</td><td class="px-6 py-4 text-blue-700 font-bold dark:text-blue-400">50–80 BYN</td><td class="hidden px-6 py-4 text-slate-500 dark:text-slate-400 sm:table-cell">от 1 часа</td></tr>
            <tr><td class="px-6 py-4 font-medium text-slate-900 dark:text-white">Замена подшипников</td><td class="px-6 py-4 text-blue-700 font-bold dark:text-blue-400">80–130 BYN</td><td class="hidden px-6 py-4 text-slate-500 dark:text-slate-400 sm:table-cell">от 1 часа</td></tr>
            <tr><td class="px-6 py-4 font-medium text-slate-900 dark:text-white">Замена диодного моста</td><td class="px-6 py-4 text-blue-700 font-bold dark:text-blue-400">90–150 BYN</td><td class="hidden px-6 py-4 text-slate-500 dark:text-slate-400 sm:table-cell">в день обращения</td></tr>
            <tr><td class="px-6 py-4 font-medium text-slate-900 dark:text-white">Замена регулятора напряжения</td><td class="px-6 py-4 text-blue-700 font-bold dark:text-blue-400">60–100 BYN</td><td class="hidden px-6 py-4 text-slate-500 dark:text-slate-400 sm:table-cell">от 1 часа</td></tr>
            <tr><td class="px-6 py-4 font-medium text-slate-900 dark:text-white">Полная переборка</td><td class="px-6 py-4 text-blue-700 font-bold dark:text-blue-400">130–220 BYN</td><td class="hidden px-6 py-4 text-slate-500 dark:text-slate-400 sm:table-cell">в день обращения</td></tr>
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-sm text-slate-500 dark:text-slate-400">Цены ориентировочные и зависят от модели генератора и состояния узла. Точную стоимость называем после диагностики — до начала работ.</p>
    </div>
  </section>

  <Faq items={generatorFaq} title="Вопросы о ремонте генераторов" />
  <RegionBlock />

  <!-- CTA -->
  <section class="bg-white dark:bg-slate-900">
    <div class="mx-auto max-w-6xl px-4 py-16 text-center">
      <h2 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">Генератор не заряжает?</h2>
      <p class="mx-auto mt-3 max-w-xl text-slate-600 dark:text-slate-400">Позвоните — по симптомам подскажем, в чём может быть дело. Приезжайте без записи: {site.hours}.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={site.phones[0].href} data-goal="call" class="rounded-2xl bg-blue-600 px-8 py-4 text-lg font-bold text-white shadow-lg shadow-blue-600/25 transition hover:bg-blue-700">Позвонить</a>
        <MessengerButtons size="lg" />
      </div>
    </div>
  </section>
</SiteLayout>
