---
import SiteLayout from '../../layouts/SiteLayout.astro';
import MessengerButtons from '../../components/MessengerButtons.astro';
import { site, articles } from '../../data/site';

export function getStaticPaths() {
  return articles.map((a) => ({ params: { slug: a.slug }, props: { a } }));
}

const { a } = Astro.props;
const dateRu = new Date(a.date).toLocaleDateString('ru-BY', { day: 'numeric', month: 'long', year: 'numeric' });

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: a.title,
    description: a.lead,
    datePublished: a.date,
    author: { '@type': 'AutoRepair', name: site.legalName, url: site.url },
    publisher: { '@type': 'AutoRepair', name: site.legalName, url: site.url },
    mainEntityOfPage: `${site.url}/stati/${a.slug}/`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Статьи', item: `${site.url}/stati/` },
      { '@type': 'ListItem', position: 3, name: a.title, item: `${site.url}/stati/${a.slug}/` },
    ],
  },
];
---

<SiteLayout title={`${a.title} — RSG Group, Минск`} description={a.lead}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <article class="bg-white dark:bg-slate-900">
    <div class="mx-auto max-w-3xl px-4 pb-16 pt-12">
      <nav class="mb-4 text-sm text-slate-500 dark:text-slate-400"><a href="/" class="hover:text-blue-600">Главная</a> / <a href="/stati/" class="hover:text-blue-600">Статьи</a> / <span class="text-slate-700 dark:text-slate-300">{a.title}</span></nav>
      <span class="text-xs text-slate-500 dark:text-slate-400">{dateRu}</span>
      <h1 class="mt-3 text-3xl font-extrabold leading-tight tracking-tight text-slate-900 dark:text-white md:text-4xl">{a.title}</h1>
      <p class="mt-5 text-lg leading-relaxed text-slate-600 dark:text-slate-400">{a.lead}</p>

      <div class="mt-10">
        {a.sections.map((s) => (
          <section class="mb-8">
            <h2 class="text-xl font-extrabold tracking-tight text-slate-900 dark:text-white">{s.h}</h2>
            <p class="mt-3 leading-relaxed text-slate-700 dark:text-slate-300">{s.p}</p>
          </section>
        ))}
      </div>
    </div>
  </article>

  <!-- CTA -->
  <section class="bg-white dark:bg-slate-900">
    <div class="mx-auto max-w-6xl px-4 py-16 text-center">
      <h2 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">Похоже на вашу ситуацию?</h2>
      <p class="mx-auto mt-3 max-w-xl text-slate-600 dark:text-slate-400">Позвоните или напишите — по симптомам подскажем вероятную причину и вилку цены. Приезжайте без записи: {site.hours}.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={site.phones[0].href} data-goal="call" class="rounded-2xl bg-blue-600 px-8 py-4 text-lg font-bold text-white shadow-lg shadow-blue-600/25 transition hover:bg-blue-700">Позвонить</a>
        <MessengerButtons size="lg" />
      </div>
    </div>
  </section>
</SiteLayout>
