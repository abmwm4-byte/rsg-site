---
import SiteLayout from '../../layouts/SiteLayout.astro';
import MessengerButtons from '../../components/MessengerButtons.astro';
import { site, articles } from '../../data/site';
---

<SiteLayout
  title="Статьи о стартерах и генераторах — советы мастеров RSG Group, Минск"
  description="Полезные статьи: как понять, что генератор или стартер умирает, почему разряжается аккумулятор, когда ехать в сервис. Опыт мастерской RSG Group, Минск."
>
  <section class="bg-white dark:bg-slate-900">
    <div class="mx-auto max-w-6xl px-4 pb-12 pt-12">
      <nav class="mb-4 text-sm text-slate-500 dark:text-slate-400"><a href="/" class="hover:text-blue-600">Главная</a> / <span class="text-slate-700 dark:text-slate-300">Статьи</span></nav>
      <h1 class="max-w-2xl text-4xl font-extrabold leading-tight tracking-tight text-slate-900 dark:text-white md:text-5xl">Статьи и советы</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-600 dark:text-slate-400">
        Делимся опытом мастерской: как вовремя распознать неисправность и не переплатить за ремонт.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="grid gap-5 md:grid-cols-2">
      {articles.map((a) => (
        <a href={`/stati/${a.slug}/`} class="group rounded-3xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-xl dark:border-slate-700 dark:bg-slate-800">
          <h2 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-blue-600">{a.title}</h2>
          <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{a.lead}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-white dark:bg-slate-900">
    <div class="mx-auto max-w-6xl px-4 py-16 text-center">
      <h2 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">Остались вопросы?</h2>
      <p class="mx-auto mt-3 max-w-xl text-slate-600 dark:text-slate-400">Позвоните или напишите — подскажем по симптомам. Приезжайте без записи: {site.hours}.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={site.phones[0].href} data-goal="call" class="rounded-2xl bg-blue-600 px-8 py-4 text-lg font-bold text-white shadow-lg shadow-blue-600/25 transition hover:bg-blue-700">Позвонить</a>
        <MessengerButtons size="lg" />
      </div>
    </div>
  </section>
</SiteLayout>
