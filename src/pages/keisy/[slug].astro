---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import MessengerButtons from '../../components/MessengerButtons.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  return cases.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<SiteLayout
  title={`${d.title} — кейс RSG Group, Минск`}
  description={`${d.car}. ${d.symptom} Работы: ${d.solution} Стоимость: ${d.price}, срок: ${d.time}. Гарантия 3 месяца.`}
>
  <article class="bg-white dark:bg-slate-900">
    <div class="mx-auto max-w-3xl px-4 pb-16 pt-12">
      <nav class="mb-4 text-sm text-slate-500 dark:text-slate-400"><a href="/" class="hover:text-blue-600">Главная</a> / <a href="/keisy/" class="hover:text-blue-600">Кейсы</a> / <span class="text-slate-700 dark:text-slate-300">{d.car}</span></nav>

      <div class="flex items-center gap-2">
        <span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold text-blue-700">{d.unit}</span>
        <span class="text-xs text-slate-400 dark:text-slate-500">{d.date.toLocaleDateString('ru-BY', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
      </div>
      <h1 class="mt-3 text-3xl font-extrabold leading-tight tracking-tight text-slate-900 dark:text-white md:text-4xl">{d.title}</h1>

      <!-- Параметры -->
      <div class="mt-8 grid grid-cols-2 gap-4 md:grid-cols-4">
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-800">
          <div class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Авто</div>
          <div class="mt-1 font-bold text-slate-900 dark:text-white">{d.car}</div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-800">
          <div class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Узел</div>
          <div class="mt-1 font-bold text-slate-900 dark:text-white">{d.unit}</div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-800">
          <div class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Срок</div>
          <div class="mt-1 font-bold text-slate-900 dark:text-white">{d.time}</div>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-800">
          <div class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Стоимость</div>
          <div class="mt-1 font-bold text-blue-700 dark:text-blue-400">{d.price}</div>
        </div>
      </div>

      <!-- Симптом и решение -->
      <div class="mt-8 rounded-2xl border border-amber-200 bg-amber-50 p-6 dark:border-amber-800/60 dark:bg-amber-950/40">
        <div class="text-sm font-semibold uppercase tracking-wide text-amber-700 dark:text-amber-400">С чем приехал клиент</div>
        <p class="mt-2 leading-relaxed text-slate-700 dark:text-slate-300">{d.symptom}</p>
      </div>
      <div class="mt-4 rounded-2xl border border-emerald-200 bg-emerald-50 p-6 dark:border-emerald-800/60 dark:bg-emerald-950/40">
        <div class="text-sm font-semibold uppercase tracking-wide text-emerald-700 dark:text-emerald-400">Что сделали</div>
        <p class="mt-2 leading-relaxed text-slate-700 dark:text-slate-300">{d.solution}</p>
      </div>

      {d.photo && !d.before && (
        <img src={d.photo} alt={d.title} loading="lazy" decoding="async" class="mx-auto mt-8 block max-h-[560px] w-auto max-w-full rounded-3xl border border-slate-200 dark:border-slate-700" />
      )}

      <!-- История -->
      <div class="mt-8 max-w-none leading-relaxed text-slate-700 dark:text-slate-300 [&>p]:mb-4">
        <Content />
      </div>

      <p class="mt-8 rounded-2xl bg-blue-50 p-5 text-sm text-slate-600 dark:bg-blue-950/50 dark:text-slate-400">
        Гарантия на работы и запчасти — {site.warranty}. Цены в кейсах — фактические на момент ремонта;
        в вашем случае стоимость может отличаться, точную назовём после диагностики.
      </p>
    </div>
  </article>

  {d.before && d.after && (
    <BeforeAfter before={d.before} after={d.after} title="Фото до и после" subtitle="Реальные снимки этого ремонта" />
  )}

  <!-- CTA -->
  <section class="bg-white dark:bg-slate-900">
    <div class="mx-auto max-w-6xl px-4 py-16 text-center">
      <h2 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">Похожая проблема?</h2>
      <p class="mx-auto mt-3 max-w-xl text-slate-600 dark:text-slate-400">Позвоните или напишите — подскажем по симптомам. Приезжайте без записи: {site.hours}.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={site.phones[0].href} data-goal="call" class="rounded-2xl bg-blue-600 px-8 py-4 text-lg font-bold text-white shadow-lg shadow-blue-600/25 transition hover:bg-blue-700">Позвонить</a>
        <MessengerButtons size="lg" />
      </div>
    </div>
  </section>
</SiteLayout>
