---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import MessengerButtons from '../../components/MessengerButtons.astro';
import { site } from '../../data/site';

const cases = (await getCollection('cases')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
// Превью *-thumb.jpg генерирует scripts/make-thumbs.mjs перед каждым билдом
const withThumb = (src?: string) =>
  src && /\.jpe?g$/i.test(src) ? src.replace(/\.jpe?g$/i, '-thumb.jpg') : src;
---

<SiteLayout
  title="Кейсы по ремонту стартеров и генераторов — RSG Group, Минск"
  description="Реальные кейсы из мастерской RSG Group: симптомы, причины, работы, сроки и цены. Ремонт стартеров и генераторов в Минске с гарантией 3 месяца."
>
  <section class="bg-white dark:bg-slate-900">
    <div class="mx-auto max-w-6xl px-4 pb-12 pt-12">
      <nav class="mb-4 text-sm text-slate-500"><a href="/" class="hover:text-blue-600">Главная</a> / <span class="text-slate-700">Кейсы</span></nav>
      <h1 class="max-w-2xl text-4xl font-extrabold leading-tight tracking-tight text-slate-900 dark:text-white md:text-5xl">Кейсы из мастерской</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-600 dark:text-slate-400">
        Реальные ремонты: с чем приехали, что оказалось, что сделали и сколько это стоило.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="grid gap-5 md:grid-cols-2">
      {cases.map((entry) => (
        <a href={`/keisy/${entry.id}/`} class="group overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-xl dark:border-slate-700 dark:bg-slate-800">
          {(entry.data.after || entry.data.photo) && (
            <img src={withThumb(entry.data.after ?? entry.data.photo)} alt={entry.data.title} loading="lazy" decoding="async" width="640" height="360" class="aspect-[16/9] w-full object-cover" />
          )}
          <div class="p-6">
            <div class="flex items-center gap-2">
              <span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold text-blue-700 dark:bg-blue-950 dark:text-blue-300">{entry.data.unit}</span>
              <span class="text-xs text-slate-400 dark:text-slate-500">{entry.data.date.toLocaleDateString('ru-BY', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
            </div>
            <h2 class="mt-3 text-xl font-bold text-slate-900 dark:text-white group-hover:text-blue-600">{entry.data.title}</h2>
            <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{entry.data.symptom}</p>
            <div class="mt-4 flex items-center justify-between border-t border-slate-100 pt-4 dark:border-slate-700 text-sm">
              <span class="font-extrabold text-blue-700 dark:text-blue-400">{entry.data.price}</span>
              <span class="text-slate-500">{entry.data.time}</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-white dark:bg-slate-900">
    <div class="mx-auto max-w-6xl px-4 py-16 text-center">
      <h2 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">Узнали свою проблему?</h2>
      <p class="mx-auto mt-3 max-w-xl text-slate-600 dark:text-slate-400">Позвоните или напишите — подскажем по симптомам и назовём примерную цену. Приезжайте без записи: {site.hours}.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={site.phones[0].href} data-goal="call" class="rounded-2xl bg-blue-600 px-8 py-4 text-lg font-bold text-white shadow-lg shadow-blue-600/25 transition hover:bg-blue-700">Позвонить</a>
        <MessengerButtons size="lg" />
      </div>
    </div>
  </section>
</SiteLayout>
