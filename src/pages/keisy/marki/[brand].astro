---
import { getCollection } from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import MessengerButtons from '../../../components/MessengerButtons.astro';
import { site } from '../../../data/site';
import { withThumb } from '../../../utils/thumb';
import { brandFromCar, brandBySlug } from '../../../utils/brand';
import Img from '../../../components/Img.astro';

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  const byBrand = new Map<string, typeof cases>();
  for (const c of cases) {
    const b = brandFromCar(c.data.car);
    if (!b) continue;
    byBrand.set(b.slug, [...(byBrand.get(b.slug) ?? []), c]);
  }
  return [...byBrand.entries()]
    .filter(([, list]) => list.length >= 1)
    .map(([slug, list]) => ({ params: { brand: slug }, props: { list } }));
}

const { list } = Astro.props;
const brand = brandBySlug(Astro.params.brand)!;
const cases = list.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Модели марки из кейсов (для текста и description)
const models = [...new Set(cases.map((c) =>
  c.data.car.replace(brand.match, '').split(/[,(]/)[0].replace(/^[-–\s]+/, '').trim()
).filter(Boolean))].slice(0, 6);

const prices = cases
  .map((c) => parseInt(c.data.price.replace(/[^\d]/g, ''), 10))
  .filter((n) => Number.isFinite(n));
const minPrice = prices.length ? Math.min(...prices) : null;

const units = [...new Set(cases.map((c) => c.data.unit))];
const unitsText = units.length === 2 ? 'стартеров и генераторов' : units[0] === 'Стартер' ? 'стартеров' : 'генераторов';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Кейсы', item: `${site.url}/keisy/` },
    { '@type': 'ListItem', position: 3, name: brand.name, item: `${site.url}/keisy/marki/${brand.slug}/` },
  ],
};
---

<SiteLayout
  title={`Ремонт ${unitsText} ${brand.name} в Минске — кейсы и цены | RSG Group`}
  description={`Ремонт ${unitsText} ${brand.name} в Минске: ${models.join(', ')}. ${cases.length} реальных кейсов с ценами и сроками${minPrice ? `, цены от ${minPrice} BYN` : ''}. Гарантия 3 месяца.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <section class="bg-white dark:bg-slate-900">
    <div class="mx-auto max-w-6xl px-4 pb-12 pt-12">
      <nav class="mb-4 text-sm text-slate-500 dark:text-slate-400"><a href="/" class="hover:text-blue-600">Главная</a> / <a href="/keisy/" class="hover:text-blue-600">Кейсы</a> / <span class="text-slate-700 dark:text-slate-300">{brand.name}</span></nav>
      <h1 class="max-w-3xl text-4xl font-extrabold leading-tight tracking-tight text-slate-900 dark:text-white md:text-5xl">Ремонт {unitsText} {brand.name}</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-600 dark:text-slate-400">
        Ремонтируем {units.length === 2 ? 'стартеры и генераторы' : units[0].toLowerCase() + 'ы'} {brand.name} со снятием и установкой или привезённый узел.
        {models.length > 0 && <> Работали с: {models.join(', ')}.</>}
      </p>
      <div class="mt-6 flex flex-wrap gap-3 text-sm">
        <span class="rounded-full bg-blue-50 px-4 py-2 font-semibold text-blue-700 dark:bg-blue-950 dark:text-blue-300">{cases.length} {cases.length === 1 ? 'кейс' : cases.length < 5 ? 'кейса' : 'кейсов'}</span>
        {minPrice && <span class="rounded-full bg-emerald-50 px-4 py-2 font-semibold text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300">цены от {minPrice} BYN</span>}
        <span class="rounded-full bg-amber-50 px-4 py-2 font-semibold text-amber-700 dark:bg-amber-950 dark:text-amber-300">гарантия 3 месяца</span>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="grid gap-5 md:grid-cols-2">
      {cases.map((entry) => (
        <a href={`/keisy/${entry.id}/`} class="group overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-xl dark:border-slate-700 dark:bg-slate-800">
          {(entry.data.after || entry.data.photo) && (
            <Img src={withThumb(entry.data.after ?? entry.data.photo)!} alt={entry.data.title} width={640} height={360} class="aspect-[16/9] w-full object-cover" />
          )}
          <div class="p-6">
            <div class="flex items-center gap-2">
              <span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold text-blue-700 dark:bg-blue-950 dark:text-blue-300">{entry.data.unit}</span>
              <span class="text-xs text-slate-500 dark:text-slate-400">{entry.data.date.toLocaleDateString('ru-BY', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
            </div>
            <h2 class="mt-3 text-xl font-bold text-slate-900 dark:text-white group-hover:text-blue-600">{entry.data.title}</h2>
            <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{entry.data.symptom}</p>
            <div class="mt-4 flex items-center justify-between border-t border-slate-100 pt-4 dark:border-slate-700 text-sm">
              <span class="font-extrabold text-blue-700 dark:text-blue-400">{entry.data.price}</span>
              <span class="text-slate-500 dark:text-slate-400">{entry.data.time}</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-white dark:bg-slate-900">
    <div class="mx-auto max-w-6xl px-4 py-16 text-center">
      <h2 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">Проблема со стартером или генератором {brand.name}?</h2>
      <p class="mx-auto mt-3 max-w-xl text-slate-600 dark:text-slate-400">Позвоните или напишите — подскажем по симптомам и назовём примерную цену. Приезжайте без записи: {site.hours}.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={site.phones[0].href} data-goal="call" class="rounded-2xl bg-blue-600 px-8 py-4 text-lg font-bold text-white shadow-lg shadow-blue-600/25 transition hover:bg-blue-700">Позвонить</a>
        <MessengerButtons size="lg" />
      </div>
    </div>
  </section>
</SiteLayout>
