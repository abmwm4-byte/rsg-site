---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import MessengerButtons from '../../components/MessengerButtons.astro';
import { site } from '../../data/site';
import { withThumb } from '../../utils/thumb';
import { brandFromCar } from '../../utils/brand';
import Img from '../../components/Img.astro';

const cases = (await getCollection('cases'))
  .filter((c) => c.data.unit === 'Генератор')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Марки этого узла — для фильтра
const brandCounts = new Map<string, { name: string; count: number }>();
for (const c of cases) {
  const b = brandFromCar(c.data.car);
  if (!b) continue;
  const cur = brandCounts.get(b.slug);
  brandCounts.set(b.slug, { name: b.name, count: (cur?.count ?? 0) + 1 });
}
const unitBrands = [...brandCounts.entries()].sort((a, b) => b[1].count - a[1].count);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Кейсы', item: `${site.url}/keisy/` },
    { '@type': 'ListItem', position: 3, name: 'Генераторы', item: `${site.url}/keisy/generatory/` },
  ],
};
---

<SiteLayout
  title="Кейсы по ремонту генераторов — цены и сроки | RSG Group, Минск"
  description={`Реальные кейсы ремонта генераторов: ${cases.length} ремонтов с ценами, сроками и фото. Замена щёток, подшипников, реле-регулятора, диодного моста. Гарантия 3 месяца.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <section class="bg-white dark:bg-slate-900">
    <div class="mx-auto max-w-6xl px-4 pb-12 pt-12">
      <nav class="mb-4 text-sm text-slate-500 dark:text-slate-400"><a href="/" class="hover:text-blue-600">Главная</a> / <a href="/keisy/" class="hover:text-blue-600">Кейсы</a> / <span class="text-slate-700 dark:text-slate-300">Генераторы</span></nav>
      <h1 class="max-w-2xl text-4xl font-extrabold leading-tight tracking-tight text-slate-900 dark:text-white md:text-5xl">Кейсы по генераторам</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-600 dark:text-slate-400">
        Щётки, подшипники, реле-регуляторы, диодные мосты — реальные ремонты с ценами и сроками.
      </p>
      <div class="mt-6 flex flex-wrap gap-2 text-sm">
        <a href="/keisy/" class="rounded-full border border-slate-200 bg-white px-4 py-2 font-semibold text-slate-600 transition hover:border-blue-400 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:border-blue-500 dark:hover:text-blue-400">← Все кейсы</a>
        <span class="rounded-full bg-blue-600 px-4 py-2 font-semibold text-white">Генераторы · {cases.length}</span>
        <a href="/keisy/startery/" class="rounded-full border border-slate-200 bg-white px-4 py-2 font-semibold text-slate-600 transition hover:border-blue-400 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:border-blue-500 dark:hover:text-blue-400">Стартеры →</a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="mb-6 flex flex-wrap gap-2 text-sm" id="brand-filters">
      <button type="button" data-brand="all" class="filter-chip rounded-full bg-blue-600 px-4 py-2 font-semibold text-white transition">Все марки</button>
      {unitBrands.map(([slug, b]) => (
        <button type="button" data-brand={slug} class="filter-chip rounded-full border border-slate-200 bg-white px-4 py-2 font-semibold text-slate-600 transition hover:border-blue-400 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:border-blue-500 dark:hover:text-blue-400">
          {b.name} <span class="text-slate-400 dark:text-slate-500">{b.count}</span>
        </button>
      ))}
    </div>
    <div class="grid gap-5 md:grid-cols-2" id="cases-grid">
      {cases.map((entry) => (
        <a href={`/keisy/${entry.id}/`} data-brand={brandFromCar(entry.data.car)?.slug ?? ''} class="group overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-xl dark:border-slate-700 dark:bg-slate-800">
          {(entry.data.after || entry.data.photo) && (
            <Img src={withThumb(entry.data.after ?? entry.data.photo)!} alt={entry.data.title} width={640} height={360} class="aspect-[16/9] w-full object-cover" />
          )}
          <div class="p-6">
            <div class="flex items-center gap-2">
              <span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold text-blue-700 dark:bg-blue-950 dark:text-blue-300">{entry.data.unit}</span>
              <span class="text-xs text-slate-500 dark:text-slate-400">{entry.data.date.toLocaleDateString('ru-BY', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
            </div>
            <h2 class="mt-3 text-xl font-bold text-slate-900 dark:text-white group-hover:text-blue-600">{entry.data.title}</h2>
            <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{entry.data.symptom}</p>
            <div class="mt-4 flex items-center justify-between border-t border-slate-100 pt-4 dark:border-slate-700 text-sm">
              <span class="font-extrabold text-blue-700 dark:text-blue-400">{entry.data.price}</span>
              <span class="text-slate-500 dark:text-slate-400">{entry.data.time}</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-white dark:bg-slate-900">
    <div class="mx-auto max-w-6xl px-4 py-16 text-center">
      <h2 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">Проблема с генератором?</h2>
      <p class="mx-auto mt-3 max-w-xl text-slate-600 dark:text-slate-400">Позвоните или напишите — подскажем по симптомам и назовём примерную цену. Приезжайте без записи: {site.hours}.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={site.phones[0].href} data-goal="call" class="rounded-2xl bg-blue-600 px-8 py-4 text-lg font-bold text-white shadow-lg shadow-blue-600/25 transition hover:bg-blue-700">Позвонить</a>
        <MessengerButtons size="lg" />
      </div>
      <p class="mt-6 text-slate-600 dark:text-slate-400">
        <a href="/remont-generatorov/" class="font-semibold text-blue-600 underline decoration-blue-300 underline-offset-4 transition hover:text-blue-700 dark:text-blue-400">Ремонт генераторов — цены и условия →</a>
      </p>
    </div>
  </section>
</SiteLayout>

<script is:inline>
  // Фильтр кейсов по марке (клиентский, без перезагрузки)
  (() => {
    const chips = document.querySelectorAll('#brand-filters .filter-chip');
    const cards = document.querySelectorAll('#cases-grid > a');
    const active = 'rounded-full bg-blue-600 px-4 py-2 font-semibold text-white transition';
    const idle = 'filter-chip rounded-full border border-slate-200 bg-white px-4 py-2 font-semibold text-slate-600 transition hover:border-blue-400 hover:text-blue-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:border-blue-500 dark:hover:text-blue-400';
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const brand = chip.dataset.brand;
        chips.forEach((c) => { c.className = c === chip ? active : idle; });
        cards.forEach((card) => {
          card.style.display = brand === 'all' || card.dataset.brand === brand ? '' : 'none';
        });
      });
    });
  })();
</script>
