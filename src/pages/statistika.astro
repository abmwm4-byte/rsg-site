---
import SiteLayout from '../layouts/SiteLayout.astro';
import { env } from 'cloudflare:workers';

// Скрытая страница статистики: /statistika/?k=rsg-stats-2026
// Читает агрегаты из KV (пишет /api/online). Не индексируется, нет в меню.
export const prerender = false;

if (Astro.url.searchParams.get('k') !== 'rsg-stats-2026') {
  return new Response('Not found', { status: 404 });
}

Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

const kv = (env as { SESSION?: KVNamespace }).SESSION;

const dayKeyMinsk = (d: Date) =>
  new Intl.DateTimeFormat('sv-SE', { timeZone: 'Europe/Minsk', year: 'numeric', month: '2-digit', day: '2-digit' }).format(d);

const today = dayKeyMinsk(new Date());

let todayCount = 0;
let devices: [string, number][] = [];
let refs: [string, number][] = [];
let history: { day: string; count: number }[] = [];

if (kv) {
  todayCount = parseInt((await kv.get(`uniq:${today}:_count`)) ?? '0', 10);

  const readGroup = async (prefix: string): Promise<[string, number][]> => {
    const { keys } = await kv.list({ prefix });
    const rows = await Promise.all(
      keys.map(async (k) => [k.name.slice(prefix.length), parseInt((await kv.get(k.name)) ?? '0', 10)] as [string, number]),
    );
    return rows.sort((a, b) => b[1] - a[1]);
  };

  devices = await readGroup(`stats:${today}:dev:`);
  refs = (await readGroup(`stats:${today}:ref:`)).filter(([name]) => name !== 'Внутренние переходы');

  const days = await Promise.all(
    Array.from({ length: 7 }, async (_, i) => {
      const day = dayKeyMinsk(new Date(Date.now() - i * 86400000));
      return { day, count: parseInt((await kv.get(`uniq:${day}:_count`)) ?? '0', 10) };
    }),
  );
  history = days.reverse();
}

const devLabel: Record<string, string> = { mobile: 'Мобильные', desktop: 'Компьютеры', tablet: 'Планшеты' };
const maxHist = Math.max(1, ...history.map((h) => h.count));
const devTotal = Math.max(1, devices.reduce((s, [, n]) => s + n, 0));

const dayRu = (iso: string) =>
  new Date(iso + 'T12:00:00+03:00').toLocaleDateString('ru-BY', { weekday: 'short', day: 'numeric', month: 'short' });
---

<SiteLayout title="Статистика сайта — внутренняя" description="Внутренняя страница статистики посещаемости.">
  <section class="bg-white dark:bg-slate-900">
    <div class="mx-auto max-w-4xl px-4 py-14">
      <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">Статистика сайта</h1>
      <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">Уникальные посетители по хешу IP, сутки — по минскому времени. Данные с сегодняшнего дня.</p>

      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        <div class="rounded-2xl border border-blue-200 bg-blue-50 p-6 dark:border-blue-800 dark:bg-blue-950/40">
          <div class="text-sm font-semibold uppercase tracking-wide text-blue-700 dark:text-blue-400">Сегодня</div>
          <div class="mt-2 text-4xl font-extrabold text-blue-700 dark:text-blue-300">{todayCount}</div>
          <div class="mt-1 text-sm text-slate-600 dark:text-slate-400">уникальных посетителей</div>
        </div>
        {devices.map(([dev, n]) => (
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6 dark:border-slate-700 dark:bg-slate-800">
            <div class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">{devLabel[dev] ?? dev}</div>
            <div class="mt-2 text-4xl font-extrabold text-slate-900 dark:text-white">{n}</div>
            <div class="mt-1 text-sm text-slate-600 dark:text-slate-400">{Math.round((n / devTotal) * 100)}% от сегодняшних</div>
          </div>
        ))}
      </div>

      <div class="mt-10 grid gap-8 md:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-800">
          <h2 class="font-bold text-slate-900 dark:text-white">Откуда пришли сегодня</h2>
          {refs.length === 0 ? (
            <p class="mt-4 text-sm text-slate-500">Данных пока нет — сбор источников начался сегодня.</p>
          ) : (
            <ul class="mt-4 space-y-2.5">
              {refs.map(([name, n]) => (
                <li class="flex items-center justify-between gap-3 text-sm">
                  <span class="truncate font-medium text-slate-700 dark:text-slate-300">{name}</span>
                  <span class="shrink-0 rounded-full bg-slate-100 px-2.5 py-0.5 font-bold text-slate-700 dark:bg-slate-700 dark:text-slate-200">{n}</span>
                </li>
              ))}
            </ul>
          )}
        </div>

        <div class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-800">
          <h2 class="font-bold text-slate-900 dark:text-white">Последние 7 дней</h2>
          <ul class="mt-4 space-y-2.5">
            {history.map((h) => (
              <li class="flex items-center gap-3 text-sm">
                <span class="w-20 shrink-0 text-slate-500 dark:text-slate-400">{dayRu(h.day)}</span>
                <span class="h-4 rounded bg-blue-500/80" style={`width: ${(h.count / maxHist) * 100}%`}></span>
                <span class="shrink-0 font-bold text-slate-700 dark:text-slate-200">{h.count || '—'}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <p class="mt-8 text-xs leading-relaxed text-slate-400 dark:text-slate-500">
        Погрешность ±2%: двойные вкладки могут дать +1, смена IP в мобильной сети — повторный зачёт.
        Боты не засчитываются. Полная аналитика (пути по сайту, записи сессий) — в Яндекс.Метрике.
      </p>
    </div>
  </section>
</SiteLayout>
