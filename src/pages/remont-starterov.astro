---
import SiteLayout from '../layouts/SiteLayout.astro';
import Faq from '../components/Faq.astro';
import MessengerButtons from '../components/MessengerButtons.astro';
import RouteButton from '../components/RouteButton.astro';
import RegionBlock from '../components/RegionBlock.astro';
import RelatedCases from '../components/RelatedCases.astro';
import { site, starterSymptoms, starterFaq } from '../data/site';
---

<SiteLayout
  title="Ремонт стартеров в Минске — от 60 BYN, диагностика бесплатно | RSG Group"
  description="Ремонт стартеров любой сложности в Минске: щётки 80–100, бендикс 110–140, втягивающее 135–170, переборка 45 фикс. Бесплатная диагностика на стенде, гарантия 3 месяца. Без выходных 9:00–19:00."
>
  <!-- Hero страницы -->
  <section class="bg-white dark:bg-slate-900">
    <div class="mx-auto max-w-6xl px-4 pb-12 pt-12">
      <nav class="mb-4 text-sm text-slate-500 dark:text-slate-400"><a href="/" class="hover:text-blue-600">Главная</a> / <span class="text-slate-700">Ремонт стартеров</span></nav>
      <h1 class="max-w-2xl text-4xl font-extrabold leading-tight tracking-tight text-slate-900 dark:text-white md:text-5xl">Ремонт стартеров в Минске</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-600 dark:text-slate-400">
        Переборка, замена щёток, бендикса, втулок, втягивающего реле. Проверка на стенде до и после ремонта.
        Большинство работ — в день обращения, благодаря собственному складу запчастей.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href={site.phones[0].href} data-goal="call" class="rounded-2xl bg-blue-600 px-6 py-4 text-base font-bold text-white shadow-lg shadow-blue-600/25 transition hover:bg-blue-700 sm:px-8 sm:text-lg">{site.phones[0].number}</a>
        <RouteButton size="lg" />
        <MessengerButtons size="lg" />
      </div>
    </div>
  </section>

  <!-- Симптомы -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="mb-8 text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">Когда пора к нам</h2>
    <div class="grid gap-4 md:grid-cols-2">
      {starterSymptoms.map((s) => (
        <div class="flex items-start gap-3 rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-800">
          <svg class="mt-0.5 h-5 w-5 shrink-0 text-blue-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 9v4m0 4h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg>
          <span class="text-slate-700">{s}</span>
        </div>
      ))}
    </div>
    <p class="mt-6 rounded-2xl bg-blue-50 p-5 text-slate-700 dark:bg-blue-950/50 dark:text-slate-300">
      Не уверены, что дело в стартере? Приезжайте на диагностику — проверим также аккумулятор и проводку, чтобы вы не платили за лишнее.
    </p>
  </section>

  <!-- Цены -->
  <section class="bg-white dark:bg-slate-900">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <h2 class="mb-8 text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">Цены на ремонт стартеров</h2>
      <div class="overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-700">
        <table class="w-full text-left">
          <thead class="bg-slate-50 text-sm font-semibold text-slate-600 dark:bg-slate-800 dark:text-slate-400">
            <tr><th class="px-6 py-4">Работа</th><th class="px-6 py-4">Стоимость</th><th class="hidden px-6 py-4 sm:table-cell">Срок</th></tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
            <tr><td class="px-6 py-4 font-medium text-slate-900 dark:text-white">Диагностика на стенде</td><td class="px-6 py-4 text-blue-700 font-bold dark:text-blue-400">Бесплатно</td><td class="hidden px-6 py-4 text-slate-500 dark:text-slate-400 sm:table-cell">в день обращения</td></tr>
            <tr><td class="px-6 py-4 font-medium text-slate-900 dark:text-white">Замена щёток</td><td class="px-6 py-4 text-blue-700 font-bold dark:text-blue-400">80–100 BYN</td><td class="hidden px-6 py-4 text-slate-500 dark:text-slate-400 sm:table-cell">в день обращения</td></tr>
            <tr><td class="px-6 py-4 font-medium text-slate-900 dark:text-white">Замена бендикса</td><td class="px-6 py-4 text-blue-700 font-bold dark:text-blue-400">110–140 BYN</td><td class="hidden px-6 py-4 text-slate-500 dark:text-slate-400 sm:table-cell">в день обращения</td></tr>
            <tr><td class="px-6 py-4 font-medium text-slate-900 dark:text-white">Замена втягивающего реле</td><td class="px-6 py-4 text-blue-700 font-bold dark:text-blue-400">135–170 BYN</td><td class="hidden px-6 py-4 text-slate-500 dark:text-slate-400 sm:table-cell">в день обращения</td></tr>
            <tr><td class="px-6 py-4 font-medium text-slate-900 dark:text-white">Замена втулок</td><td class="px-6 py-4 text-blue-700 font-bold dark:text-blue-400">60–70 BYN</td><td class="hidden px-6 py-4 text-slate-500 dark:text-slate-400 sm:table-cell">в день обращения</td></tr>
            <tr><td class="px-6 py-4 font-medium text-slate-900 dark:text-white">Переборка (разборка, дефектовка, сборка)</td><td class="px-6 py-4 text-blue-700 font-bold dark:text-blue-400">45 BYN фикс</td><td class="hidden px-6 py-4 text-slate-500 dark:text-slate-400 sm:table-cell">в день обращения</td></tr>
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-sm text-slate-500 dark:text-slate-400">Цены ориентировочные и указаны с учётом работы; запчасти при необходимости оплачиваются отдельно по факту. Переборка — разборка, дефектовка и сборка узла. Точную стоимость называем после бесплатной диагностики — до начала работ.</p>
    </div>
  </section>

  <RelatedCases unit="Стартер" title="Недавние кейсы по стартерам" />

  <Faq items={starterFaq} title="Вопросы о ремонте стартеров" />
  <RegionBlock />

  <!-- CTA -->
  <section class="bg-white dark:bg-slate-900">
    <div class="mx-auto max-w-6xl px-4 py-16 text-center">
      <h2 class="text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">Стартер щёлкает, но не крутит?</h2>
      <p class="mx-auto mt-3 max-w-xl text-slate-600 dark:text-slate-400">Позвоните — по симптомам подскажем, в чём может быть дело. Приезжайте без записи: {site.hours}.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={site.phones[0].href} data-goal="call" class="rounded-2xl bg-blue-600 px-8 py-4 text-lg font-bold text-white shadow-lg shadow-blue-600/25 transition hover:bg-blue-700">Позвонить</a>
        <MessengerButtons size="lg" />
      </div>
    </div>
  </section>
</SiteLayout>
